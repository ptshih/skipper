{
  "worktree": { "bgIsolation": "none" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/scripts/guard-hook.ts\"",
            "timeout": 10,
            "statusMessage": "Checking the STOP list…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/scripts/docs-hook.ts\"",
            "timeout": 30,
            "statusMessage": "Checking docs truth system…"
          }
        ]
      }
    ]
  }
}
