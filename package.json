{
  "name": "skipper",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20.19.4",
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/api",
    "apps/admin",
    "apps/site",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenvx run -f .env.development -- bun --filter @skipper/api dev",
    "dev:admin": "concurrently -k -n server,client -c blue.bold,green.bold \"PORT=8788 ADMIN_DEV_BYPASS=1 dotenvx run -f .env.development -- bun --filter @skipper/admin dev:server\" \"bun --filter @skipper/admin dev:client\"",
    "dev:site": "bun --filter @skipper/site dev",
    "sim": "dotenvx run -f .env.development -- bun packages/sim/src/run.ts",
    "tf:feedback": "dotenvx run -f .env.development -- bun scripts/pull-testflight-feedback.ts",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "lint:docs": "bun scripts/lint-docs.ts",
    "lint:types": "bun scripts/lint-type-collisions.ts",
    "lint:enums": "bun scripts/lint-enums.ts",
    "check": "bun run lint:docs && bun run lint:types && bun run lint:enums && bun run typecheck && bun run test",
    "reinstall": "rm -rf node_modules && bun install",
    "prepare": "dotenvx ext precommit --install || true",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "db:preflight": "bun scripts/db-preflight.ts",
    "db:generate": "bun run db:preflight && dotenvx run -f .env.development -- bun --filter @skipper/db db:generate",
    "db:push": "bun run db:preflight && dotenvx run -f .env.development -- bun --filter @skipper/db db:push",
    "db:migrate": "dotenvx run -f .env.development -- bun --filter @skipper/db db:migrate",
    "db:migrate:prod": "dotenvx run -f .env.production --overload -- bun --filter @skipper/db db:migrate",
    "db:studio": "dotenvx run -f .env.development -- bun --filter @skipper/db db:studio"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.14.0",
    "concurrently": "^10.0.3",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@posthog/cli",
    "esbuild"
  ],
  "overrides": {
    "esbuild": "0.28.1"
  }
}
