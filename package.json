{
  "name": "skipper",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20.19.4",
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "db:generate": "bun --env-file=.env --filter @skipper/db db:generate",
    "db:push": "bun --env-file=.env --filter @skipper/db db:push",
    "db:migrate": "bun --env-file=.env --filter @skipper/db db:migrate",
    "db:studio": "bun --env-file=.env --filter @skipper/db db:studio"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
