{
  "name": "skipper",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20.19.4",
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/api",
    "apps/admin-api",
    "apps/admin-web",
    "apps/site",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenvx run -f .env.development -- bun --filter @skipper/api dev",
    "sim": "dotenvx run -f .env.development -- bun packages/sim/src/run.ts",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "lint:docs": "bun scripts/lint-docs.ts",
    "lint:types": "bun scripts/lint-type-collisions.ts",
    "check": "bun run lint:docs && bun run lint:types && bun run typecheck && bun run test",
    "prepare": "dotenvx ext precommit --install || true",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "db:generate": "dotenvx run -f .env.development -- bun --filter @skipper/db db:generate",
    "db:push": "dotenvx run -f .env.development -- bun --filter @skipper/db db:push",
    "db:migrate": "dotenvx run -f .env.development -- bun --filter @skipper/db db:migrate",
    "db:migrate:prod": "dotenvx run -f .env.production --overload -- bun --filter @skipper/db db:migrate",
    "db:studio": "dotenvx run -f .env.development -- bun --filter @skipper/db db:studio"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.71.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
