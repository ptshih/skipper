{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/guard-hook.ts\" --codex",
            "timeout": 10,
            "statusMessage": "Checking the STOP list…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/docs-hook.ts\"",
            "timeout": 30,
            "statusMessage": "Checking docs truth system…"
          }
        ]
      }
    ]
  }
}
