# Plaintext reference of every env var (committed). Real values live in the
# dotenvx-encrypted .env.development / .env.production (also committed).
# Set a value:  dotenvx set KEY "value" -f .env.development
# Onboarding:   get .env.keys from a teammate (never committed), then `bun run dev`.
#
# Layout: REQUIRED to boot the API + studio locally, then optional social sign-in,
# generation tuning knobs (all have code defaults), the admin ops console, the mobile
# client bundle, and finally deploy/runtime-injected vars you never set by hand.

# ============================================================================
# REQUIRED — the API + studio won't run without these
# ============================================================================

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# --- AI (Anthropic) ---
# Read by THREE surfaces, not just the studio: the generation pipeline (narration, enrich, curate,
# the eval panel), the admin console's two model-backed helpers, and — since 1.1 — the LIVE PLANNER
# behind `POST /drives/plan`. That last one runs in the RIDER REQUEST PATH, so an unset key in prod
# is not a degraded studio: every plan turn fails and NO rider can create a drive at all (the app
# shows the in-persona outage line; see RISK-2 in docs/designs/drives-first-1-1.md).
# ⚠ Model ids are NOT configured here — they live in `CLAUDE_MODELS` (packages/shared/src/models.ts),
# where the planner deliberately holds its own key so a narration bump can't silently repoint it.
ANTHROPIC_API_KEY=sk-ant-...

# --- TTS: Google Cloud Text-to-Speech (Gemini-TTS voices, bills GCP credits) ---
# Auth is OAuth/ADC — text:synthesize takes NO API key (the Gemini voices route through
# Vertex and need an IAM identity an AIza key can't carry). Setup: enable BOTH
# texttospeech.googleapis.com AND aiplatform.googleapis.com, grant the principal
# roles/aiplatform.user (Gemini-TTS needs aiplatform.endpoints.predict), then EITHER
# a service-account JSON (requires the iam.disableServiceAccountKeyCreation org policy OFF):
#   GOOGLE_APPLICATION_CREDENTIALS=/abs/path/sa-key.json
# OR user ADC (`gcloud auth application-default login`) and set GOOGLE_TTS_USE_ADC=1.
GOOGLE_CLOUD_PROJECT=...           # billing/quota project (sent as x-goog-user-project)
GOOGLE_APPLICATION_CREDENTIALS=    # abs path to a service-account JSON (or blank + use ADC)
GOOGLE_TTS_USE_ADC=                # set to 1 when using gcloud ADC instead of a key file

# --- Google Maps Platform (Routes + Places New) — studio route/place lookups ---
GOOGLE_MAPS_API_KEY=...

# --- Wikipedia ---
# No key required (geosearch + extracts are public). Keep CC BY-SA attribution.

# --- Object storage for audio (Cloudflare R2 by default) ---
# The code uses Bun's native S3Client, so ANY S3-compatible provider works.
R2_ACCOUNT_ID=...                 # R2 only — builds the R2 endpoint. Leave blank if S3_ENDPOINT is set.
R2_ACCESS_KEY_ID=...              # S3 access key id  (R2 token / Tigris key / AWS key)
R2_SECRET_ACCESS_KEY=...          # S3 secret access key
R2_BUCKET=skipper-audio           # bucket name (globally unique on Tigris/AWS)
# Optional override — point the SAME code at a non-R2 provider via an explicit endpoint:
#   Tigris:  S3_ENDPOINT=https://t3.storage.dev                 (S3_REGION blank → "auto")
#   AWS S3:  S3_ENDPOINT=https://s3.us-west-2.amazonaws.com     S3_REGION=us-west-2
#   Blank both → Cloudflare R2 (endpoint derived from R2_ACCOUNT_ID).
S3_ENDPOINT=
S3_REGION=
# Audio objects are PRIVATE; the API serves short-lived presigned URLs after the
# freemium tier check — no public base URL needed.

# --- Auth (Better Auth) — the API ---
BETTER_AUTH_SECRET=...             # openssl rand -base64 32; the API boot FAILS without it
# NOTE: there is deliberately NO BETTER_AUTH_URL — the auth base URL is derived per-request
# from the validated Host header (apps/api/src/auth.ts `baseURL.allowedHosts`/`fallback`),
# so dev, the prod service, and preview hosts all work with nothing to set.
PORT=8787                          # API listen port (Cloud Run injects its own at runtime)

# --- Rate limiting: how far to trust x-forwarded-for ---
# Trusted infra hops to skip from the RIGHT of x-forwarded-for before taking the client IP — the
# key every per-IP rider-spend cap buckets on. 0 is correct for the CURRENT topology (a Cloud Run
# domain mapping, no load balancer). Set 1 only if an external HTTPS LB is put in front. A wrong
# value can only over-share a bucket (over-block), never re-open the spoofing bypass.
TRUSTED_PROXY_HOPS=                # (default: 0) see apps/api/src/rate-limit.ts

# --- Transactional email (Resend) — password reset ---
# REQUIRED before public signup. Email/password is the only sign-in method in prod (no social
# creds set), and there's no email verification — so without a working reset, a forgotten password
# is PERMANENT account loss (drives + credits included; the ledger never refunds). The API boots
# without it and WARNS loudly; every reset request then 500s while Better Auth's
# enumeration-safe reply still tells the rider "check your email". Don't ship it unset.
# The EMAIL_FROM domain must be VERIFIED in Resend (DNS records on skipper.fm). Skipper shares the
# Manoa Resend account, so sending is scoped to a SUBDOMAIN (notifications.skipper.fm) — Resend's own
# guidance, and it keeps a consumer app's sending reputation off both the apex (which Firebase serves)
# and Manoa Health's mail. See docs/decisions/account-deletion-and-recovery.md.
RESEND_API_KEY=re_...
EMAIL_FROM=                        # sender (default: "Skipper <skipper@notifications.skipper.fm>")
EMAIL_REPLY_TO=                    # reply-to on sent mail AND the support address the app shows a
                                   # rider who runs out of credits (default: hello@skipper.fm — the
                                   # founder rule is ONE published inbox). Read in two places
                                   # (apps/api/src/email.ts, apps/api/src/drives.ts), same default.
SITE_ORIGIN=                       # marketing-site origin, hosts /reset-password + the legal docs
                                   # (default: https://skipper.fm). Also allowlisted as a Better Auth
                                   # trusted origin — a reset redirect off-allowlist is REJECTED.

# ⚠ SAMPLE_NARRATION_QID WAS REMOVED HERE (2026-08-05) with `GET /sample`, the mobile screen that
# called it and the onboarding gate that showed it. The anonymous taste is now the preview clip on
# POST /drives/propose, which needs no config: it is drawn from the rider's own planned route.
# ⚠ It was a GO-LIVE GATE for App Review, so if any runbook still says "set the sample QID before
# submitting", that step is now void — docs/designs/onboarding-gate-reconsidered.md.

# --- Credits (the free allotment) ---
# Lifetime free drive generations granted once per account (apps/api/src/credits.ts). A grant's
# amount FREEZES when written, so raising this only affects accounts not yet granted. Keep it
# BOUNDED: there's no email verification, so the cap is the ceiling on signup-farmed Routes spend
# (the RATE is bounded separately, by createDriveLimiter — see apps/api/src/limits.ts).
FREE_DRIVE_CAP=50                  # lifetime free drives per NEW account. 50 by founder call
                                   # 2026-08-04, raised from 10: running out is a CONVERSATION, not a
                                   # paywall — the 403 sends the rider to hello@skipper.fm for a free
                                   # top-up (an admin grant) — but at 10 a rider who is enjoying the
                                   # thing hit that wall inside one trip. Admin/demo/test accounts go
                                   # ABOVE this with explicit grants, never by moving this number.
                                   # ⚠ Changing this affects only accounts created AFTER it — a grant's
                                   # amount is frozen at signup, so existing riders need an admin grant
                                   # either way. Keep the code default in credits.ts EQUAL to this.

# ============================================================================
# OPTIONAL — social sign-in (each provider registers ONLY if BOTH its creds are set;
# the server boots fine without them — email/password is always on)
# ============================================================================
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
APPLE_CLIENT_ID=...                # Sign in with Apple
# ⚠ NOT A PASTE-ONCE SECRET, AND FILLING IT IN AS ONE IS A TIME BOMB. Apple's client secret is an
# ES256 JWT you SIGN, and Apple rejects any whose exp is >15,777,000 s (SIX MONTHS) past iat — so a
# static value here works, then silently 401s months later on the one path a locked-out rider cannot
# route around, with no alarm. Doing it properly needs APPLE_TEAM_ID + APPLE_KEY_ID + a .p8 private
# key + `jose`, and an async-factory `socialProviders.apple` in apps/api/src/auth.ts (which today
# takes a plain object and cannot express the regenerating form). ⚠ The native ID-token flow does NOT
# avoid this — @better-auth/core disables the provider outright without a secret. Adding Google also
# OBLIGES this one under App Store 4.8. See docs/designs/lowest-friction-signup.md §1a before filling
# either Apple line in.
APPLE_CLIENT_SECRET=...

# ============================================================================
# TestFlight feedback puller (scripts/pull-testflight-feedback.ts → `bun run tf:feedback`)
# Optional ops tool — read-only App Store Connect API. Generate a Team API key at
# App Store Connect → Users and Access → Integrations → App Store Connect API (role
# App Manager/Admin); the .p8 goes in keys/ (gitignored), NOT here.
# ============================================================================
ASC_KEY_ID=...                     # the API key's Key ID (also names keys/AuthKey_<KEYID>.p8)
ASC_ISSUER_ID=...                  # the team's Issuer ID (top of the Integrations page)
ASC_API_KEY_PATH=                  # override .p8 path (default: keys/AuthKey_<ASC_KEY_ID>.p8)
ASC_APP_ID=                        # default app id for the pull (or pass --app; --list-apps to find it)

# ============================================================================
# GENERATION tuning knobs (packages/studio/src/config.ts) — ALL optional; the
# code default is shown. Leave blank to take the default.
# ============================================================================
# Enrichers — set to `off` to disable; any other value (incl. blank) = ON:
SKIPPER_GEOLOGY=                   # Macrostrat geology enrichment              (default: on)
SKIPPER_WIKIDATA=                  # Wikidata enrichment                        (default: on)
SKIPPER_GROUNDING_EVAL=            # Opus grounding eval pass (`off` skips it)  (default: on)
SKIPPER_GROUNDING_VOTES=           # grounding samples voted per clip; 1 = the old single-sample
                                   # gate                                       (default: 3)
# Concurrency — positive integer:
SKIPPER_NARRATION_CONCURRENCY=     # (default: 12)
SKIPPER_TTS_CONCURRENCY=           # (default: 12)
SKIPPER_SCOUT_CONCURRENCY=         # (default: 4)

# ============================================================================
# ADMIN ops console (apps/admin) — founder-only Hono API + Vite/React SPA
# ============================================================================
ADMIN_EMAIL=...                    # the single IAP principal `requireAdmin` asserts (prod)
ADMIN_DEV_BYPASS=                  # =1 skips IAP locally (IGNORED when NODE_ENV=production)
# Both admin model knobs default to `CLAUDE_MODELS.opus` (packages/shared/src/models.ts) — override
# only to A/B a model for one helper without touching the shared constant. ⚠ Neither is the planner.
ADMIN_PROPOSE_MODEL=               # proposes a REGION's bbox from its name (Regions → propose bbox)
ADMIN_CURATE_MODEL=                # drafts a region's curated `places` — the set that IS the planner's
                                   # endpoint allowlist. ⚠ SPENDS; founder-gated like any paid run.
ADMIN_WEB_ROOT=                    # built-SPA dir the Hono server serves (default: ./public)
# Admin CLIENT (Vite) — browser Maps key; PUBLIC + referrer-restricted, baked at build
# (cloudbuild.admin.yaml --build-arg). Blank → the admin map renders a "set this" hint.
VITE_GOOGLE_MAPS_BROWSER_KEY=...
# Admin CLIENT (Vite) — cloud Map ID for AdvancedMarkers (GCP console → Map Management). Blank →
# Google's DEMO_MAP_ID (works, but stamps a "for development" watermark). Set a real one for prod.
VITE_GOOGLE_MAPS_MAP_ID=...

# ============================================================================
# MOBILE client (apps/mobile) — EXPO_PUBLIC_* are BAKED INTO the JS bundle (public,
# never secret). All have defaults, so they're optional for local dev.
# ============================================================================
EXPO_PUBLIC_API_URL=               # backend base URL            (default: http://localhost:8787)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=   # RN maps key; blank → iOS falls back to Apple Maps
EXPO_PUBLIC_SUPPORT_EMAIL=         # in-app support address      (default: hello@skipper.fm)
EXPO_PUBLIC_POSTHOG_KEY=           # PostHog project API key (public client key). ⚠ Blank makes `track()`
                                   # a NO-OP, so the whole 1.1 funnel silently emits nothing — the one
                                   # setting that decides whether any event exists.
EXPO_PUBLIC_POSTHOG_HOST=          # PostHog ingestion host      (default: https://us.i.posthog.com; EU: https://eu.i.posthog.com)
# NOT an EXPO_PUBLIC_ var — read by app.config.ts at PREBUILD, never at JS runtime:
SKIPPER_LAN_HTTP=                  # =1 adds the Tailscale ATS exception so a Release-config dev build
                                   # can reach the laptop over plain HTTP. Set on the EAS `development`
                                   # profiles; export by hand for `expo run:ios --device`. ⚠ Shipped
                                   # builds must carry NO exception — leave blank. Needs a native rebuild.

# ============================================================================
# OPS one-shots — you set these INLINE on a single command, never in a .env file.
# Putting either in a file defeats the point: both are deliberate, per-invocation.
# ============================================================================
# SKIPPER_ALLOW_DESTRUCTIVE_DDL=1  — lets `bun run db:generate` / `db:push` proceed when the schema
#                                  DROPS a table. Refused (exit 1) without it. ⚠ The preflight
#                                  compares TABLE NAMES only — a dropped column or constraint is
#                                  just as destructive and is NOT caught. dev and prod point at the
#                                  SAME Neon host, so this is always a production DDL.
# SNAPSHOT_STAMP                   — names the `snapshot-corpus` output dir under studio's gitignored
#                                  .scratch/ (default: snapshot). Set it to keep runs apart.

# ============================================================================
# DEPLOY / RUNTIME-INJECTED — documented for completeness; you normally DON'T set
# these by hand (the runtime / dispatcher / dotenvx provides them).
# ============================================================================
# NODE_ENV                       — 'production' in prod (set by the runtime); locally it gates ADMIN_DEV_BYPASS.
# STUDIO_JOB_NAME / STUDIO_JOB_REGION  — the Cloud Run Job the admin dispatches to (defaults: skipper-studio / us-east4);
#                                  override only to target a different job.
# STUDIO_JOB_ID / STUDIO_JOB_TRIGGERED_BY — injected PER-EXECUTION by the admin dispatcher; the gen job's progress
#                                  hook is a no-op without STUDIO_JOB_ID, so the laptop CLI stays byte-identical.
# CLOUD_RUN_EXECUTION            — injected automatically by Cloud Run; recorded for job reconciliation.
# DOTENV_PRIVATE_KEY_PRODUCTION  — the dotenvx decrypt key for .env.production; lives ONLY in gitignored
#                                  .env.keys (local) / Secret Manager (prod), NEVER in this file.
