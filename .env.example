# Plaintext reference of every env var (committed). Real values live in the
# dotenvx-encrypted .env.development / .env.production (also committed).
# Set a value:  dotenvx set KEY "value" -f .env.development
# Onboarding:   get .env.keys from a teammate (never committed), then `bun run dev`.
#
# Layout: REQUIRED to boot the API + studio locally, then optional social sign-in,
# generation tuning knobs (all have code defaults), the admin ops console, the mobile
# client bundle, and finally deploy/runtime-injected vars you never set by hand.

# ============================================================================
# REQUIRED — the API + studio won't run without these
# ============================================================================

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...      # narration (claude-opus-4-8)

# --- TTS: Google Cloud Text-to-Speech (Gemini-TTS voices, bills GCP credits) ---
# Auth is OAuth/ADC — text:synthesize takes NO API key (the Gemini voices route through
# Vertex and need an IAM identity an AIza key can't carry). Setup: enable BOTH
# texttospeech.googleapis.com AND aiplatform.googleapis.com, grant the principal
# roles/aiplatform.user (Gemini-TTS needs aiplatform.endpoints.predict), then EITHER
# a service-account JSON (requires the iam.disableServiceAccountKeyCreation org policy OFF):
#   GOOGLE_APPLICATION_CREDENTIALS=/abs/path/sa-key.json
# OR user ADC (`gcloud auth application-default login`) and set GOOGLE_TTS_USE_ADC=1.
GOOGLE_CLOUD_PROJECT=...           # billing/quota project (sent as x-goog-user-project)
GOOGLE_APPLICATION_CREDENTIALS=    # abs path to a service-account JSON (or blank + use ADC)
GOOGLE_TTS_USE_ADC=                # set to 1 when using gcloud ADC instead of a key file

# --- Google Maps Platform (Routes + Places New) — studio route/place lookups ---
GOOGLE_MAPS_API_KEY=...

# --- Wikipedia ---
# No key required (geosearch + extracts are public). Keep CC BY-SA attribution.

# --- Object storage for audio (Cloudflare R2 by default) ---
# The code uses Bun's native S3Client, so ANY S3-compatible provider works.
R2_ACCOUNT_ID=...                 # R2 only — builds the R2 endpoint. Leave blank if S3_ENDPOINT is set.
R2_ACCESS_KEY_ID=...              # S3 access key id  (R2 token / Tigris key / AWS key)
R2_SECRET_ACCESS_KEY=...          # S3 secret access key
R2_BUCKET=skipper-audio           # bucket name (globally unique on Tigris/AWS)
# Optional override — point the SAME code at a non-R2 provider via an explicit endpoint:
#   Tigris:  S3_ENDPOINT=https://t3.storage.dev                 (S3_REGION blank → "auto")
#   AWS S3:  S3_ENDPOINT=https://s3.us-west-2.amazonaws.com     S3_REGION=us-west-2
#   Blank both → Cloudflare R2 (endpoint derived from R2_ACCOUNT_ID).
S3_ENDPOINT=
S3_REGION=
# Audio objects are PRIVATE; the API serves short-lived presigned URLs after the
# freemium tier check — no public base URL needed.

# --- Auth (Better Auth) — the API ---
BETTER_AUTH_SECRET=...             # openssl rand -base64 32; the API boot FAILS without it
# NOTE: there is deliberately NO BETTER_AUTH_URL — the auth base URL is derived per-request
# from the validated Host header (apps/api/src/auth.ts `baseURL.allowedHosts`/`fallback`),
# so dev, the prod service, and preview hosts all work with nothing to set.
PORT=8787                          # API listen port (Cloud Run injects its own at runtime)

# ============================================================================
# OPTIONAL — social sign-in (each provider registers ONLY if BOTH its creds are set;
# the server boots fine without them — email/password is always on)
# ============================================================================
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
APPLE_CLIENT_ID=...                # Sign in with Apple
APPLE_CLIENT_SECRET=...

# ============================================================================
# TestFlight feedback puller (scripts/pull-testflight-feedback.ts → `bun run tf:feedback`)
# Optional ops tool — read-only App Store Connect API. Generate a Team API key at
# App Store Connect → Users and Access → Integrations → App Store Connect API (role
# App Manager/Admin); the .p8 goes in keys/ (gitignored), NOT here.
# ============================================================================
ASC_KEY_ID=...                     # the API key's Key ID (also names keys/AuthKey_<KEYID>.p8)
ASC_ISSUER_ID=...                  # the team's Issuer ID (top of the Integrations page)
ASC_API_KEY_PATH=                  # override .p8 path (default: keys/AuthKey_<ASC_KEY_ID>.p8)
ASC_APP_ID=                        # default app id for the pull (or pass --app; --list-apps to find it)

# ============================================================================
# GENERATION tuning knobs (packages/studio/src/config.ts) — ALL optional; the
# code default is shown. Leave blank to take the default.
# ============================================================================
# Enrichers — set to `off` to disable; any other value (incl. blank) = ON:
SKIPPER_GEOLOGY=                   # Macrostrat geology enrichment              (default: on)
SKIPPER_WIKIDATA=                  # Wikidata enrichment                        (default: on)
SKIPPER_GROUNDING_EVAL=            # Opus grounding eval pass (`off` skips it)  (default: on)
# Concurrency — positive integer:
SKIPPER_NARRATION_CONCURRENCY=     # (default: 6)
SKIPPER_TTS_CONCURRENCY=           # (default: 6)
SKIPPER_SCOUT_CONCURRENCY=         # (default: 4)
# Facts cache (principle #1's TTL):
SKIPPER_FACTS_TTL_HOURS=           # reuse stored facts within N hours; 0 = always re-fetch (default: 168)

# ============================================================================
# ADMIN ops console (apps/admin) — founder-only Hono API + Vite/React SPA
# ============================================================================
ADMIN_EMAIL=...                    # the single IAP principal `requireAdmin` asserts (prod)
ADMIN_DEV_BYPASS=                  # =1 skips IAP locally (IGNORED when NODE_ENV=production)
ADMIN_PROPOSE_MODEL=               # Create-Tour propose model         (default: claude-opus-4-8)
ADMIN_WEB_ROOT=                    # built-SPA dir the Hono server serves (default: ./public)
# Admin CLIENT (Vite) — browser Maps key; PUBLIC + referrer-restricted, baked at build
# (cloudbuild.admin.yaml --build-arg). Blank → the admin map renders a "set this" hint.
VITE_GOOGLE_MAPS_BROWSER_KEY=...
# Admin CLIENT (Vite) — cloud Map ID for AdvancedMarkers (GCP console → Map Management). Blank →
# Google's DEMO_MAP_ID (works, but stamps a "for development" watermark). Set a real one for prod.
VITE_GOOGLE_MAPS_MAP_ID=...

# ============================================================================
# MOBILE client (apps/mobile) — EXPO_PUBLIC_* are BAKED INTO the JS bundle (public,
# never secret). All have defaults, so they're optional for local dev.
# ============================================================================
EXPO_PUBLIC_API_URL=               # backend base URL            (default: http://localhost:8787)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=   # RN maps key; blank → iOS falls back to Apple Maps
EXPO_PUBLIC_WEB_URL=               # share-link base             (default: https://skipper.fm)
EXPO_PUBLIC_SUPPORT_EMAIL=         # in-app support address      (default: feedback@skipper.fm)

# ============================================================================
# DEPLOY / RUNTIME-INJECTED — documented for completeness; you normally DON'T set
# these by hand (the runtime / dispatcher / dotenvx provides them).
# ============================================================================
# NODE_ENV                       — 'production' in prod (set by the runtime); locally it gates ADMIN_DEV_BYPASS.
# STUDIO_JOB_NAME / STUDIO_JOB_REGION  — the Cloud Run Job the admin dispatches to (defaults: skipper-studio / us-east4);
#                                  override only to target a different job.
# STUDIO_JOB_ID / STUDIO_JOB_TRIGGERED_BY — injected PER-EXECUTION by the admin dispatcher; the gen job's progress
#                                  hook is a no-op without STUDIO_JOB_ID, so the laptop CLI stays byte-identical.
# CLOUD_RUN_EXECUTION            — injected automatically by Cloud Run; recorded for job reconciliation.
# DOTENV_PRIVATE_KEY_PRODUCTION  — the dotenvx decrypt key for .env.production; lives ONLY in gitignored
#                                  .env.keys (local) / Secret Manager (prod), NEVER in this file.
