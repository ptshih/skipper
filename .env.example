# Copy to .env and fill in. Bun auto-loads .env; never commit the real file.

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...      # narration (claude-opus-4-8)
OPENAI_API_KEY=sk-...             # TTS (gpt-4o-mini-tts)

# --- Google Maps Platform (Routes + Places New) ---
GOOGLE_MAPS_API_KEY=...

# --- Wikipedia ---
# No key required (geosearch + extracts are public). Keep CC BY-SA attribution.

# --- Cloudflare R2 (audio storage) ---
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=skipper-audio
R2_PUBLIC_BASE_URL=https://audio.example.com

# --- API ---
PORT=8787
