.env
.env.keys
.env.*.local
!.env.example

# Logs
*.log

# Claude Code (local agent runtime state — locks, worktrees)
.claude/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# NOTE: bun.lock (text lockfile) IS committed — do not ignore it.
