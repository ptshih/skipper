# Dependencies
node_modules/

# Build outputs
dist/
build/
out/
.next/
web-build/

# Expo / React Native (apps/mobile). CNG: the native ios/ + android/ dirs are
# GENERATED by `npx expo prebuild` (from app.json + config plugins), so we do NOT
# commit them — native config (e.g. the carplay-audio entitlement) belongs in
# app.json / a config plugin, not hand-edited in the generated project.
.expo/
.expo-shared/
apps/mobile/ios/
apps/mobile/android/
*.orig.*
*.keystore

# TypeScript
*.tsbuildinfo

# Env files (dotenvx). Encrypted .env.development / .env.production ARE committed;
# the plaintext .env, the private keys, and *.local overrides are NOT.
.env
.env.keys
.env.*.local
!.env.example

# Keys — service-account JSON etc. NEVER commit (auth secrets)
keys/
key/
*-sa-key.json

# Logs
*.log

# Scratch / throwaway verification scripts (agent workspace)
.scratch/
# Scratch audio (generator TTS/clip output dumped during verification)
.scratch-audio/
# Design-review agent output (local report artifacts, not committed)
.design-review/

# Claude Code: local agent runtime state (locks, worktrees) stays ignored,
# but the SHARED project settings (hooks — the docs lint) are committed.
.claude/*
!.claude/settings.json

# Codex
.codex/*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# NOTE: bun.lock (text lockfile) IS committed — do not ignore it.
