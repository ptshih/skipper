---
// The first drive — Lake Tahoe, gorgeously. The "optimize for charm, not scale"
// answer to Autio's 25,000-story flex: show ONE real route beautifully instead
// of faking a catalog. Honest framing — this is the LAUNCH drive (no production
// tours are published yet), so it's a roadmap promise, not a present-tense claim.
//
// The itinerary doubles as a SAMPLER (Autio's strongest move): ready stops play
// a few seconds inline, so visitors hear the persona's RANGE, not just one clip.
import Icon from '../Icon.astro'
// Each stop can carry a short sample `clip` (public path). A stop WITH a clip is
// tappable and plays inline; one WITHOUT shows an honest "soon" chip — no dead
// players. Stop 1's clip IS the hero clip (the Emerald Bay telling), so the
// sampler has a real, working sample from day one. Drop a founder-blessed MP3 at
// the path and the stop lights up — same drop-in pattern as the hero clip
// (public/clips/README.md). Keep paths in west-shore order.
const stops = [
  { n: 1, name: 'Emerald Bay Overlook', sub: 'the postcard everyone stops for', kind: 'Scenic', tone: 'teal', clip: '/clips/skipper-hero.mp3' },
  { n: 2, name: 'Vikingsholm & the lake’s only island', sub: 'a castle, a teahouse, and a very tall tale', kind: 'Story', tone: 'pine', clip: null /* '/clips/skipper-vikingsholm.mp3' */ },
  { n: 3, name: 'Inspiration Point', sub: 'named by a committee, earned by the view', kind: 'Scenic', tone: 'teal', clip: null /* '/clips/skipper-inspiration-point.mp3' */ },
  { n: 4, name: 'D.L. Bliss & water so clear it’s rude', sub: 'facts about clarity, jokes about your windshield', kind: 'Story', tone: 'pine', clip: null /* '/clips/skipper-dl-bliss.mp3' */ },
  { n: 5, name: 'A coffee stop the Skipper picked himself', sub: 'he has opinions about pie', kind: 'Pit stop', tone: 'amber', clip: null /* '/clips/skipper-coffee.mp3' */ },
]
const toneVar: Record<string, string> = { pine: 'var(--accent)', teal: 'var(--water)', amber: 'var(--amber)' }
// pin coordinates down the west shore (matches the list order)
const pins = [
  { x: 104, y: 92, tone: 'teal' },
  { x: 94, y: 138, tone: 'pine', glow: true },
  { x: 97, y: 190, tone: 'teal' },
  { x: 114, y: 240, tone: 'pine' },
  { x: 134, y: 284, tone: 'amber' },
]
---

<section class="section drive" id="the-drive">
  <div class="container">
    <header class="drive__head">
      <span class="kicker">The first drive</span>
      <h2 class="title">We’re starting with one lake. We’re starting with it right.</h2>
      <p class="lede prose">
        Skipper launches with Lake Tahoe — one region, narrated stop by stop. No endless menu of
        half-baked tours. One place, done like someone actually cared.
      </p>
    </header>

    <div class="drive__grid">
      <!-- poster-grade route map (illustration, not a live map) -->
      <div class="drive__map card">
        <svg viewBox="0 0 260 330" class="drive__svg" role="img" aria-label="Illustrated route map down the west shore of Lake Tahoe">
          <!-- compass -->
          <g transform="translate(214 36)" opacity="0.8">
            <path d="M0 -14 L4 0 L0 14 L-4 0 Z" fill="var(--accent-warm)"></path>
            <path d="M-14 0 L0 4 L14 0 L0 -4 Z" fill="var(--ink-faint)"></path>
            <text x="0" y="-18" text-anchor="middle" fill="var(--ink-dim)" font-family="'Overpass Mono', monospace" font-size="8">N</text>
          </g>
          <!-- lake — traced from the real Lake Tahoe outline: notched north end,
               the concave "pinch" on the east shore (Cave Rock), bumpy west coast -->
          <path
            d="M185 28 C200 36 211 60 216 84 C221 104 224 120 224 138 C224 154 215 162 210 170 C206 182 221 192 221 205 C221 222 220 232 216 245 C211 261 207 270 198 276 C188 292 168 306 150 306 C144 306 139 292 134 284 C128 270 120 258 114 240 C110 226 99 212 97 190 C96 174 95 158 94 138 C93 122 100 108 104 92 C108 72 124 52 140 46 C150 42 152 50 165 40 C173 35 178 32 185 28 Z"
            fill="color-mix(in srgb, var(--water) 22%, transparent)" stroke="var(--water)" stroke-width="1.6"></path>
          <text x="156" y="166" fill="var(--water)" font-family="'Overpass Mono', monospace" font-size="11" letter-spacing="1.5" opacity="0.85">LAKE</text>
          <text x="150" y="182" fill="var(--water)" font-family="'Overpass Mono', monospace" font-size="11" letter-spacing="1.5" opacity="0.85">TAHOE</text>
          <!-- road: untraveled dashed + traveled pine — hugs the west shore,
               threading the five stops down toward the south end -->
          <path id="drive-road" d="M104 92 C100 108 93 122 94 138 C95 158 96 174 97 190 C99 212 110 226 114 240 C120 258 128 270 134 284 C139 292 144 298 148 303"
            fill="none" stroke="var(--track-inactive)" stroke-width="2" stroke-dasharray="4 4"></path>
          <path d="M104 92 C100 108 93 122 94 138" fill="none" stroke="var(--track-active)" stroke-width="2.4"></path>
          <!-- pins -->
          {
            pins.map((p, i) => (
              <g class={p.glow ? 'pin pin--glow' : 'pin'} style={`--tone:${toneVar[p.tone]}`}>
                <circle cx={p.x} cy={p.y} r="8.5" fill="var(--surface-raised)" stroke="var(--tone)" stroke-width="2" />
                <text x={p.x} y={p.y + 3} text-anchor="middle" fill="var(--tone)" font-family="'Overpass Mono', monospace" font-size="8.5" font-weight="600">{i + 1}</text>
              </g>
            ))
          }
        </svg>
        <p class="drive__maplabel mono">Illustrated route · not to scale</p>
      </div>

      <!-- itinerary — ready stops play a short sample inline -->
      <div class="drive__itin">
        <ol class="drive__list">
          {
            stops.map((s) =>
              s.clip ? (
                <li class="drive__stopitem">
                  <button
                    class="drive__stop drive__stop--play"
                    type="button"
                    data-clip={s.clip}
                    aria-label={`Hear a few seconds of the Skipper at ${s.name}`}
                  >
                    <span class="drive__pip" style={`--tone:${toneVar[s.tone]}`}>{s.n}</span>
                    <span class="drive__stoptext">
                      <span class="drive__stopname">{s.name}</span>
                      <span class="drive__stopsub body-dim">{s.sub}</span>
                    </span>
                    <span class={`badge badge--${s.tone}`}>{s.kind}</span>
                    <span class="drive__play" aria-hidden="true">
                      <span class="drive__play-ic" data-ic-play><Icon name="play" size={15} /></span>
                      <span class="drive__play-ic" data-ic-pause hidden><Icon name="pause" size={15} /></span>
                    </span>
                  </button>
                </li>
              ) : (
                <li class="drive__stopitem">
                  <div class="drive__stop">
                    <span class="drive__pip" style={`--tone:${toneVar[s.tone]}`}>{s.n}</span>
                    <span class="drive__stoptext">
                      <span class="drive__stopname">{s.name}</span>
                      <span class="drive__stopsub body-dim">{s.sub}</span>
                    </span>
                    <span class={`badge badge--${s.tone}`}>{s.kind}</span>
                    <span class="drive__soon mono" title="Sample clip coming soon">soon</span>
                  </div>
                </li>
              )
            )
          }
        </ol>
        <p class="drive__hint mono">
          <Icon name="play" size={13} /> Tap a stop with a play icon to hear a few seconds — more light up as we record them.
        </p>
        <!-- one reused element; only one stop plays at a time (and the page-wide
             guard in index.astro pauses the hero clip if it's going). -->
        <audio data-drive-audio preload="none"></audio>
      </div>
    </div>

    <p class="drive__foot body-dim">
      More regions come after this one earns its keep. Yosemite’s in the glovebox — but one perfect
      drive beats ten rushed ones.
    </p>
  </div>
</section>

<style>
  .drive__head {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }
  .drive__head .kicker {
    margin-bottom: var(--space-md);
  }
  .drive__head .lede {
    margin-top: var(--space-lg);
    margin-inline: auto;
  }
  .drive__grid {
    display: grid;
    gap: var(--space-2xl);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 54rem) {
    .drive__grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-4xl);
    }
  }
  .drive__map {
    padding: var(--space-lg);
    position: sticky;
    top: 5rem;
  }
  .drive__svg {
    width: 100%;
    height: auto;
  }
  .pin--glow circle {
    filter: drop-shadow(0 0 7px var(--glow));
  }
  .drive__maplabel {
    text-align: center;
    margin-top: var(--space-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    font-size: var(--fs-label-sm);
  }
  .drive__itin {
    min-width: 0;
  }
  .drive__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border: var(--border-thin) solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    overflow: hidden;
  }
  .drive__stop {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-xl) var(--space-2xl);
  }
  .drive__stopitem + .drive__stopitem {
    border-top: var(--border-thin) solid var(--rule);
  }
  /* a playable stop is a full-width button — reset chrome, keep the row look */
  button.drive__stop {
    width: 100%;
    font: inherit;
    color: inherit;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease);
  }
  .drive__stop--play:hover {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  /* the now-playing row — an amber TINT + inset bar (a fill, not a glow) */
  .drive__stop.is-playing {
    background: color-mix(in srgb, var(--amber) 8%, transparent);
    box-shadow: inset 3px 0 0 var(--amber);
  }
  /* trailing play/pause affordance (the row is the click target) */
  .drive__play {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--track-inactive);
    color: var(--accent);
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .drive__play-ic {
    display: grid;
    place-items: center;
  }
  .drive__stop--play:hover .drive__play {
    border-color: var(--accent);
  }
  .drive__stop.is-playing .drive__play {
    /* amber FILL on the glyph (no halo) — keeps the one-glow rule intact */
    border-color: var(--amber);
    color: var(--amber);
  }
  /* honest placeholder for a stop whose clip isn't recorded yet */
  .drive__soon {
    flex: none;
    font-size: var(--fs-label-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: var(--border-thin) dashed var(--track-inactive);
    border-radius: var(--radius-pill);
    padding: 0.3em 0.7em;
  }
  .drive__hint {
    margin-top: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    text-align: center;
    font-size: var(--fs-label-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .drive__hint :global(svg) {
    color: var(--accent);
    flex: none;
  }
  .drive__pip {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    border: 1.6px solid var(--tone);
    color: var(--tone);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    font-weight: 600;
  }
  .drive__stoptext {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .drive__stopname {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--ink);
    font-size: var(--fs-body-lg);
    line-height: 1.25;
  }
  .drive__stopsub {
    font-size: var(--fs-meta);
  }
  .drive__stop .badge {
    flex: none;
  }
  @media (max-width: 32rem) {
    .drive__stop .badge {
      display: none;
    }
    .drive__stop {
      padding-inline: var(--space-lg);
    }
  }
  .drive__foot {
    margin-top: var(--space-2xl);
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }
</style>

<script>
  // Inline itinerary sampler. One reused <audio>; tapping a ready stop plays its
  // clip, tapping the same stop again pauses, tapping another switches. The
  // page-wide guard (index.astro) pauses the hero clip when this starts, and
  // vice-versa — so its 'pause' event also clears our row highlight.
  const section = document.getElementById('the-drive')
  const audio = section?.querySelector<HTMLAudioElement>('[data-drive-audio]')
  if (section && audio) {
    const rows = Array.from(section.querySelectorAll<HTMLButtonElement>('.drive__stop--play'))
    let activeBtn: HTMLButtonElement | null = null
    let currentClip: string | null = null

    const setRow = (btn: HTMLButtonElement | null, playing: boolean) => {
      if (!btn) return
      btn.classList.toggle('is-playing', playing)
      const pi = btn.querySelector<HTMLElement>('[data-ic-play]')
      const pa = btn.querySelector<HTMLElement>('[data-ic-pause]')
      if (pi) pi.hidden = playing
      if (pa) pa.hidden = !playing
    }

    rows.forEach((btn) => {
      btn.addEventListener('click', () => {
        const clip = btn.dataset.clip
        if (!clip) return
        // same stop, currently playing → pause it
        if (activeBtn === btn && !audio.paused) {
          audio.pause()
          return
        }
        // switch away from a different row
        if (activeBtn && activeBtn !== btn) setRow(activeBtn, false)
        if (clip !== currentClip) {
          audio.src = clip
          currentClip = clip
        }
        activeBtn = btn
        setRow(btn, true)
        const p = audio.play()
        if (p) p.catch(() => setRow(btn, false)) // clip missing/blocked → no dead highlight
      })
    })

    // 'play' re-asserts (covers the transient pause a src-swap fires); 'pause'
    // (user OR the page-wide guard) and 'ended' clear the highlight.
    audio.addEventListener('play', () => setRow(activeBtn, true))
    audio.addEventListener('pause', () => setRow(activeBtn, false))
    audio.addEventListener('ended', () => setRow(activeBtn, false))
  }
</script>
