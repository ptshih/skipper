---
// Hero — name the category, SHOW the mechanic, let them HEAR him. The primary
// action is a real ~20s Skipper clip, ungated (no app, no account): the whole
// "persona is the product" bet leads with his voice. Audio degrades gracefully
// to a charming "warming up" state until a blessed MP3 lands in public/clips/.
import Sunburst from '../Sunburst.astro'
import Trail from '../Trail.astro'
import Icon from '../Icon.astro'

// Swap-in point for the hero clip. Drop a founder-blessed ~20s MP3 at this path
// (see public/clips/README.md). If it 404s, the player shows the warming state.
const HERO_CLIP = '/clips/skipper-hero.mp3'
const HERO_STOP = 'Emerald Bay overlook'
---

<section class="hero section" id="top">
  <Sunburst originY="30%" />
  <!-- Centered two-column: the headline/lede/CTA stack on the left, the player +
       its car-trail as ONE centered unit on the right. With the headline at its
       trimmed size the columns are close enough in height that centering leaves
       only modest, symmetric breathing room — no corner void, no clipped player. -->
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 class="display">
        Your road trip just hired a tour guide with a terrible sense of humor.
      </h1>
      <p class="lede">
        A narrated driving tour for your phone. Mount it, start driving, and a corny old guide
        tells the story of every lake, lookout, and one-stoplight town right as you reach it. No
        reading, no tapping — press play and he’s already talking.
      </p>
      <div class="hero__cta">
        <div class="hero__buttons">
          <!-- The PRIMARY action: hear him. Amber-FILLED but deliberately NOT
               glowing — the one allowed amber glow in this viewport is reserved
               for the player disc (tokens.css). So this button drops the
               btn--primary halo for a neutral lift; it controls the same audio. -->
          <button class="btn btn--primary hero__playcta" type="button" data-hero-play-cta aria-controls="hero-player">
            <span class="hero__playcta-ic" data-cta-ic-play><Icon name="play" size={20} /></span>
            <span class="hero__playcta-ic" data-cta-ic-pause hidden><Icon name="pause" size={20} /></span>
            <span data-cta-label>Hear the Skipper</span>
          </button>
          <a class="btn btn--secondary" href="#the-drive">
            <Icon name="mappin" size={20} /> See the drive
          </a>
        </div>
      </div>
    </div>

    <!-- The one glowing object on the page: the NOW-playing placard + its trail. -->
    <div class="hero__player">
      <figure class="player framed" id="hero-player" data-hero-player aria-label="Listen to a sample from the Skipper">
        <figcaption class="player__head">
          <!-- aria-live: this readout is the ONLY signal that play/pause/ended happened. Sighted
               users get the icon flip; without this, AT users got nothing at all. -->
          <span class="player__state" data-state aria-live="polite">Sample clip</span>
          <span class="player__stop">{HERO_STOP}</span>
        </figcaption>

        <div class="player__body">
          <button
            class="disc"
            data-play
            type="button"
            aria-pressed="false"
            aria-label="Play the Emerald Bay sample from the Skipper"
          >
            <span class="disc__icon" data-icon-play><Icon name="play" size={34} /></span>
            <span class="disc__icon disc__icon--pause" data-icon-pause hidden><Icon name="pause" size={32} /></span>
          </button>

          <div class="player__meter">
            <p class="player__label">Hear the Skipper</p>
            <!-- A real seek control, so it owes a real role. It was a bare <div> with a click
                 handler: mouse users could scrub, keyboard users had no way to reach it and AT
                 could not see it at all. The <audio> has no `controls`, so there is no fallback. -->
            <div
              class="scrub"
              data-scrub
              role="slider"
              tabindex="0"
              aria-label="Seek within the sample"
              aria-valuemin="0"
              aria-valuemax="0"
              aria-valuenow="0"
              aria-valuetext="0:00"
            >
              <span class="scrub__fill" data-scrub-fill></span>
              <span class="scrub__thumb" data-scrub-thumb></span>
            </div>
            <div class="player__times mono">
              <span data-time-cur>0:00</span>
              <span data-time-dur>0:23</span>
            </div>
          </div>
        </div>

        <p class="player__caption mono" data-caption>EMERALD BAY OVERLOOK · his real voice, his real corn</p>
        <audio data-audio src={HERO_CLIP} preload="metadata"></audio>
      </figure>

      <!-- the atlas trail: car parked at the trailhead, glides as he talks -->
      <Trail trailId="hero-trail" progress={0} class="hero__trail" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-4xl);
    overflow: hidden;
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-3xl);
    align-items: center;
  }
  @media (min-width: 62rem) {
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      column-gap: var(--space-4xl);
      align-items: center;
    }
  }
  .hero .display {
    margin-bottom: var(--space-xl);
  }
  .hero__cta {
    margin-top: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    align-items: flex-start;
  }
  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  /* Amber fill, NO glow — the disc keeps the single per-viewport glow. */
  .hero__playcta {
    box-shadow: 0 6px 18px -8px var(--shadow-cast);
  }
  .hero__playcta:hover {
    color: var(--on-amber);
    box-shadow: 0 9px 24px -8px var(--shadow-cast);
  }
  .hero__playcta-ic {
    display: inline-grid;
    place-items: center;
  }

  /* ── Player placard ── */
  .player {
    background: var(--surface-raised);
    padding: var(--space-3xl);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--amber) 14%, transparent),
      0 22px 70px -28px var(--glow), 0 10px 30px -18px var(--shadow-cast);
  }
  .player__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-2xl);
  }
  .player__state {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-label-sm);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-warm);
  }
  .player__stop {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-heading);
    color: var(--ink);
  }
  .player__body {
    display: flex;
    align-items: center;
    gap: var(--space-2xl);
  }
  .disc {
    flex: none;
    width: 5rem;
    height: 5rem;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--amber);
    color: var(--on-amber);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--amber) 10%, transparent),
      0 10px 34px -8px var(--glow);
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-base) var(--ease);
  }
  .disc:hover {
    transform: scale(1.04);
  }
  .disc:active {
    transform: scale(0.97);
  }
  .disc__icon {
    display: grid;
    place-items: center;
    margin-left: 3px; /* optical-center the play triangle */
  }
  .disc__icon--pause {
    margin-left: 0;
  }
  .player__meter {
    flex: 1 1 auto;
    min-width: 0;
  }
  .player__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-subhead);
    margin-bottom: var(--space-md);
  }
  .scrub {
    position: relative;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--surface-sunken);
    box-shadow: inset 0 1px 2px var(--shadow-cast);
  }
  .scrub__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--p, 0) * 100%);
    background: var(--track-active);
    border-radius: var(--radius-pill);
  }
  .scrub__thumb {
    position: absolute;
    top: 50%;
    left: calc(var(--p, 0) * 100%);
    width: 14px;
    height: 14px;
    border-radius: var(--radius-pill);
    background: var(--amber);
    border: 2px solid var(--surface-raised);
    transform: translate(-50%, -50%);
    box-shadow: 0 0 10px -1px var(--glow);
  }
  .player__times {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-md);
    font-size: var(--fs-meta);
    color: var(--ink-dim);
  }
  .player__caption {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--border-thin) dashed var(--track-inactive);
    font-size: var(--fs-label-sm);
    letter-spacing: 0.05em;
    color: var(--ink-faint);
    text-transform: uppercase;
  }
  .hero__trail {
    margin-top: var(--space-xl);
    padding-inline: var(--space-sm);
  }

  /* graceful "no clip yet" state */
  .player.is-warming .disc {
    background: var(--surface-sunken);
    color: var(--ink-dim);
    box-shadow: inset 0 0 0 1.5px var(--keyline);
    cursor: default;
  }
  .player.is-warming .disc:hover {
    transform: none;
  }
  .player.is-warming {
    box-shadow: 0 10px 30px -18px var(--shadow-cast);
  }
</style>

<script>
  // Inline hero audio: ungated, no framework. Toggles play/pause, drives the
  // scrubber + timer + the under-card car token, and degrades to a charming
  // "warming up" state if the clip isn't there yet.
  function fmt(t: number) {
    if (!isFinite(t) || t < 0) t = 0
    const m = Math.floor(t / 60)
    const s = Math.floor(t % 60)
    return `${m}:${s.toString().padStart(2, '0')}`
  }

  const root = document.querySelector<HTMLElement>('[data-hero-player]')
  if (root) {
    const audio = root.querySelector<HTMLAudioElement>('[data-audio]')!
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!
    const iconPlay = root.querySelector<HTMLElement>('[data-icon-play]')!
    const iconPause = root.querySelector<HTMLElement>('[data-icon-pause]')!
    const stateEl = root.querySelector<HTMLElement>('[data-state]')!
    const capEl = root.querySelector<HTMLElement>('[data-caption]')!
    const fill = root.querySelector<HTMLElement>('[data-scrub-fill]')!
    const thumb = root.querySelector<HTMLElement>('[data-scrub-thumb]')!
    const curEl = root.querySelector<HTMLElement>('[data-time-cur]')!
    const durEl = root.querySelector<HTMLElement>('[data-time-dur]')!
    const scrub = root.querySelector<HTMLElement>('[data-scrub]')!
    const trail = document.getElementById('hero-trail')

    // The primary hero CTA lives in the COPY column (outside the player card),
    // so it's queried from the document, not from `root`. It controls the same
    // audio and mirrors play/pause state.
    const ctaBtn = document.querySelector<HTMLButtonElement>('[data-hero-play-cta]')
    const ctaLabel = ctaBtn?.querySelector<HTMLElement>('[data-cta-label]') ?? null
    const ctaIcPlay = ctaBtn?.querySelector<HTMLElement>('[data-cta-ic-play]') ?? null
    const ctaIcPause = ctaBtn?.querySelector<HTMLElement>('[data-cta-ic-pause]') ?? null

    const setCtaPlaying = (playing: boolean) => {
      if (ctaIcPlay) ctaIcPlay.hidden = playing
      if (ctaIcPause) ctaIcPause.hidden = !playing
      if (ctaLabel) ctaLabel.textContent = playing ? 'Pause the Skipper' : 'Hear the Skipper'
    }

    let available = true
    const setProgress = (p: number) => {
      p = Math.max(0, Math.min(1, p))
      scrub.style.setProperty('--p', String(p))
      trail?.style.setProperty('--progress', String(p))
    }

    const warmUp = () => {
      available = false
      root.classList.add('is-warming')
      stateEl.textContent = 'WARMING UP'
      capEl.textContent = 'ENGINE’S STILL WARMING UP · the sample clip lands at launch'
      playBtn.setAttribute('aria-disabled', 'true')
      playBtn.setAttribute('aria-label', 'Sample clip coming at launch')
      if (ctaBtn) {
        ctaBtn.setAttribute('aria-disabled', 'true')
        ctaBtn.disabled = true
      }
      if (ctaLabel) ctaLabel.textContent = 'Warming up…'
    }

    const togglePlay = () => {
      if (!available) return
      if (audio.paused) {
        const p = audio.play()
        if (p) p.catch(warmUp)
      } else {
        audio.pause()
      }
    }

    audio.addEventListener('error', warmUp)
    // metadata never loads if the file is missing on a static host
    // Keep the slider's reported value in step with playback. Sighted users read the fill and the
    // mm:ss pair; without this the same information reaches AT as nothing at all.
    const syncSlider = () => {
      if (!audio.duration || !isFinite(audio.duration)) return
      scrub.setAttribute('aria-valuemax', String(Math.round(audio.duration)))
      scrub.setAttribute('aria-valuenow', String(Math.round(audio.currentTime)))
      scrub.setAttribute('aria-valuetext', `${fmt(audio.currentTime)} of ${fmt(audio.duration)}`)
    }

    audio.addEventListener('loadedmetadata', () => {
      if (audio.duration && isFinite(audio.duration)) durEl.textContent = fmt(audio.duration)
      syncSlider()
    })
    audio.addEventListener('timeupdate', () => {
      curEl.textContent = fmt(audio.currentTime)
      if (audio.duration) setProgress(audio.currentTime / audio.duration)
      syncSlider()
    })
    audio.addEventListener('play', () => {
      iconPlay.hidden = true
      iconPause.hidden = false
      stateEl.textContent = 'NOW PLAYING'
      // The label and pressed state must move with the icons — otherwise the button still
      // announces "Play…" while it is playing, and pressing it to stop reads as pressing play twice.
      playBtn.setAttribute('aria-pressed', 'true')
      playBtn.setAttribute('aria-label', 'Pause the Emerald Bay sample from the Skipper')
      setCtaPlaying(true)
    })
    audio.addEventListener('pause', () => {
      iconPlay.hidden = false
      iconPause.hidden = true
      if (!audio.ended) stateEl.textContent = 'PAUSED'
      playBtn.setAttribute('aria-pressed', 'false')
      playBtn.setAttribute('aria-label', 'Play the Emerald Bay sample from the Skipper')
      setCtaPlaying(false)
    })
    audio.addEventListener('ended', () => {
      stateEl.textContent = 'THAT’S THE SAMPLE'
      setProgress(0)
      curEl.textContent = '0:00'
      setCtaPlaying(false)
    })

    playBtn.addEventListener('click', togglePlay)

    // ⚠ An explicit `behavior` OVERRIDES the CSS `scroll-behavior: auto` that global.css sets under
    // prefers-reduced-motion — the reduced-motion reset there cannot reach a JS-specified behavior.
    // So the one visitor who asked not to be scrolled was the one getting scrolled. Query live
    // rather than caching: the OS setting can change while the page is open.
    const revealPlayer = () =>
      root.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'center',
      })

    // The copy-column CTA toggles the same clip. On a phone the player sits below
    // the fold of the copy, so starting playback also brings the placard into view.
    ctaBtn?.addEventListener('click', () => {
      const wasPaused = audio.paused
      togglePlay()
      if (wasPaused && window.innerWidth < 992) revealPlayer()
    })

    // Cross-component trigger (the sticky mobile bar dispatches this): always
    // PLAY (never toggle to pause) and reveal the placard.
    document.addEventListener('skipper:play-hero', () => {
      if (available && audio.paused) togglePlay()
      revealPlayer()
    })

    // scrub-to-seek
    scrub.addEventListener('click', (e) => {
      if (!available || !audio.duration) return
      const r = scrub.getBoundingClientRect()
      audio.currentTime = ((e.clientX - r.left) / r.width) * audio.duration
      syncSlider()
    })

    // …and the same seek from the keyboard. Standard slider keys; without these the control is
    // reachable by Tab (role=slider, tabindex=0) but does nothing, which is worse than absent.
    scrub.addEventListener('keydown', (e) => {
      if (!available || !audio.duration) return
      const STEP = 5
      const d = audio.duration
      let next: number | null = null
      switch (e.key) {
        case 'ArrowLeft':
        case 'ArrowDown':
          next = audio.currentTime - STEP
          break
        case 'ArrowRight':
        case 'ArrowUp':
          next = audio.currentTime + STEP
          break
        case 'Home':
          next = 0
          break
        case 'End':
          next = d
          break
        case ' ':
        case 'Enter':
          e.preventDefault()
          togglePlay()
          return
        default:
          return
      }
      e.preventDefault()
      audio.currentTime = Math.min(Math.max(next, 0), d)
      syncSlider()
    })

    // The initial 404 (no clip dropped in yet) can fire its `error` before this
    // deferred module attaches the listener. Re-run source selection now that we
    // ARE listening, so the honest "warming up" state surfaces reliably.
    if (audio.error || audio.networkState === audio.NETWORK_NO_SOURCE) warmUp()
    else audio.load()
  }
</script>
