---
// Footer — minimal, honest, on-brand plumbing. Deliberately sparse (no
// affiliate/press/gift sprawl we haven't earned). The CC BY-SA attribution is
// real and load-bearing per the project's licensing invariant — not decorative.
//
// Privacy/Terms are load-bearing too: the App Store listing REQUIRES a reachable
// privacy-policy URL, so /privacy must stay linked and must stay live. The section
// links are root-relative ("/#how", not "#how") because this footer also renders on
// /privacy and /terms, where a bare hash would dead-end on the current page.
const year = 2026
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <div>
        <span class="footer__wordmark">SKIPPER</span>
        <p class="footer__tagline">A corny old skipper, a real road, and a lake that’s about to get talked about.</p>
      </div>
      <nav class="footer__links" aria-label="Footer">
        <a href="/#how">How it works</a>
        <a href="/#the-drive">The drive</a>
        <a href="/#planning">Planning</a>
        <!-- /about was reachable only from sitemap.xml until 2026-08-02 — no page linked it, so the
             one page written to answer coverage/cost/account questions had zero human entry points
             and zero internal-link signal. It is the answer-engine surface (llm-discovery-marketing.md
             move B); keep it linked. -->
        <a href="/about">About</a>
        <a href="/support">Support</a>
        <a href="mailto:hello@skipper.fm">Contact</a>
      </nav>
    </div>

    <hr class="divider-dashed footer__rule" />

    <p class="footer__attr">
      Facts in the tours are grounded in public sources, including Wikipedia (CC BY-SA). The Skipper
      keeps the byline.
    </p>
    <div class="footer__legal">
      <span>© {year} Manoa, Inc. · Made with too many puns in Nevada.</span>
      <span class="footer__dot">·</span>
      <a href="/privacy">Privacy</a>
      <span class="footer__dot">·</span>
      <a href="/terms">Terms</a>
      <span class="footer__dot">·</span>
      <a href="https://skipper.fm">skipper.fm</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--surface-sunken);
    border-top: var(--border-keyline) solid var(--keyline);
    /* keep the legal line clear of the home indicator on iOS */
    padding-block: var(--space-4xl) calc(var(--space-3xl) + env(safe-area-inset-bottom));
    /* corner screw-dots at the page's bottom edge — closing the placard frame */
    background-image:
      radial-gradient(circle at 16px 16px, var(--keyline) 1.7px, transparent 2.4px),
      radial-gradient(circle at calc(100% - 16px) 16px, var(--keyline) 1.7px, transparent 2.4px);
    background-repeat: no-repeat;
  }
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    justify-content: space-between;
  }
  @media (min-width: 44rem) {
    .footer__top {
      flex-direction: row;
      align-items: flex-start;
    }
  }
  .footer__wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-wordmark);
    letter-spacing: 0.04em;
    color: var(--ink);
  }
  .footer__tagline {
    margin-top: var(--space-sm);
    color: var(--ink-dim);
    max-width: 26rem;
    font-size: var(--fs-sm);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
    font-size: var(--fs-sm);
  }
  .footer__links a {
    color: var(--ink-dim);
    font-weight: 600;
  }
  .footer__links a:hover {
    color: var(--accent);
  }
  .footer__rule {
    margin-block: var(--space-2xl);
  }
  .footer__attr {
    color: var(--ink-faint);
    font-size: var(--fs-meta);
    max-width: 44rem;
  }
  .footer__legal {
    margin-top: var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    color: var(--ink-faint);
    font-size: var(--fs-meta);
  }
  .footer__dot {
    opacity: 0.5;
  }
</style>
