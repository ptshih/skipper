---
// How it works — three numbered steps. Kills the central category fear ("will
// this work in MY car, with no signal?") cheaply. A trimmed, Skipper-voiced
// steal of Shaka's whole /how-it-works page.
//
// ⚠ The audio step (now 03) said "your music ducks when he's got something to say" until 2026-08-02.
// It never did: skipper audio takes EXCLUSIVE focus and PAUSES the rider's music — twice-affirmed
// founder decision, see docs/decisions/drive-audio-exclusive-focus.md. Ducking was tried and
// REJECTED, so it is not a default awaiting a flip. Don't let the promise drift back.
//
// ⚠ Step 01 IS THE PRODUCT and did not exist here until 2026-08-02. The three steps used to start at
// "download the drive" — i.e. the section literally titled "How the drive works" never mentioned that
// you get a drive by TALKING to him (1.1 D6; apps/mobile/app/index.tsx "HOME IS THE CONVERSATION").
// A visitor read this, installed, and hit a chat screen. He is TYPED to, not spoken to.
import Icon from '../Icon.astro'
import Trail from '../Trail.astro'

const steps = [
  {
    n: '01',
    icon: 'quote',
    title: 'Tell him where you’re headed.',
    body: 'Say it the way you’d say it to a passenger — “Tahoe City down to Emerald Bay, we’ve got about two hours.” He picks the route and the stops worth making. No menus, no dropping pins.',
  },
  {
    n: '02',
    icon: 'cloud',
    title: 'Download it before you go.',
    body: 'The whole drive lives on your phone. Tahoe loses signal in the prettiest places; the Skipper doesn’t care.',
  },
  {
    n: '03',
    icon: 'mount',
    title: 'Drop it in the mount and drive.',
    body: 'Each story fires itself as you reach the stop — you never touch the screen. It plays over Bluetooth like a podcast and brings its own road-trip soundtrack, so give him the stereo and let your playlist sit this one out.',
  },
]
---

<section class="section how" id="how">
  <div class="container">
    <header class="how__head">
      <span class="kicker">How the drive works</span>
      <h2 class="title">Three steps. Then just drive.</h2>
    </header>

    <Trail progress={0.82} class="how__track" />

    <div class="how__cards">
      {
        steps.map((s) => (
          <article class="step">
            <div class="step__top">
              <span class="step__num mono">{s.n}</span>
              <span class="step__icon">
                <Icon name={s.icon} size={22} />
              </span>
            </div>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__body body-dim">{s.body}</p>
          </article>
        ))
      }
    </div>

    <p class="how__foot mono">Works completely offline · Plays automatically · Nothing to read while moving</p>
  </div>
</section>

<style>
  .how__head {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }
  .how__head .kicker {
    margin-bottom: var(--space-md);
  }
  .how__track {
    display: none;
    margin-bottom: var(--space-md);
  }
  @media (min-width: 52rem) {
    .how__track {
      display: block;
    }
  }
  .how__cards {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }
  @media (min-width: 52rem) {
    .how__cards {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2xl);
    }
  }
  .step {
    background: var(--surface-raised);
    border: var(--border-thin) solid var(--rule);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
  }
  .step__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }
  .step__num {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--radius-pill);
    background: var(--amber);
    color: var(--on-amber);
    font-weight: 600;
    font-size: var(--fs-body-lg);
    /* neutral lift, NOT an amber glow: three numbered discs share this viewport,
       and the "one glowing amber element per viewport" rule reserves the glow for
       the hero player / final-CTA stamp (see tokens.css). */
    box-shadow: 0 4px 12px -6px var(--shadow-cast);
  }
  .step__icon {
    color: var(--accent);
  }
  .step__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-heading);
    line-height: 1.2;
    margin-bottom: var(--space-sm);
  }
  .step__body {
    font-size: var(--fs-body);
  }
  .how__foot {
    margin-top: var(--space-2xl);
    text-align: center;
    font-size: var(--fs-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
