---
// Closing — lead with the charm line UP FRONT (not buried like Autio's tagline)
// and ONE honest pre-launch beat. The app isn't in the App Store yet, so this
// slot shows a quiet "coming soon" badge; the moment APP_STORE_URL is set it becomes
// the real "Download on the App Store" button (the same drop-in pattern as the hero
// clip — see apps/site/CLIPS.md).
//
// GO-LIVE: the URL now lives in ../../appStore.ts (ONE constant, shared with the
// MobileApplication JSON-LD in layouts/Base.astro — see there for why). The only edit
// left HERE is Apple's marketing requirement: swap the placeholder glyph for the
// official Apple-provided "Download on the App Store" badge artwork.
//
// Why the constant stays empty until approval is documented at its definition.
import Sunburst from '../Sunburst.astro'
import Trail from '../Trail.astro'
import Icon from '../Icon.astro'

// Single source shared with the MobileApplication JSON-LD in layouts/Base.astro, so §13's
// go-live is ONE edit rather than two that can silently drift apart.
import { APP_STORE_URL } from '../../appStore'
---

<section class="section final" id="launch">
  <Sunburst originY="42%" />
  <div class="container final__inner">
    <span class="kicker">End of the road (for now)</span>
    <h2 class="display final__headline">
      Every road’s got a story. This one’s got a guy who won’t let it go untold.
    </h2>
    <p class="lede prose final__sub">
      {
        APP_STORE_URL
          ? 'Skipper is in the App Store, starting with Tahoe. No sign-ups, no waiting room. He’s cleared to pick you up; hop in.'
          : 'Skipper pulls into the App Store soon, starting with Tahoe. No sign-ups, no waiting room. When he’s cleared to pick you up, the button lands right here.'
      }
    </p>

    {
      APP_STORE_URL ? (
        <a class="btn btn--primary final__cta" href={APP_STORE_URL}>
          <Icon name="download" size={20} /> Download on the App Store
        </a>
      ) : (
        <span class="final__soon" role="status">
          <Icon name="signpost" size={18} /> Coming soon to the App Store
        </span>
      )
    }

    <p class="final__micro">
      {
        APP_STORE_URL
          ? 'iPhone · starting in Lake Tahoe. Free to download, and you can still hit play up top and try him first.'
          : 'iPhone · starting in Lake Tahoe. No app to download today, just hit play up top and ride along.'
      }
    </p>

    <a class="btn btn--ghost final__secondary" href="#top">
      <Icon name="play" size={16} /> One more from the Skipper
    </a>

    <div class="final__trailwrap">
      <Trail progress={1} class="final__trail" />
      <span class="final__wordmark">SKIPPER</span>
    </div>
  </div>
</section>

<style>
  .final {
    overflow: hidden;
    text-align: center;
  }
  .final__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .final .kicker {
    margin-bottom: var(--space-lg);
  }
  .final__headline {
    max-width: 22ch;
  }
  .final__sub {
    margin-top: var(--space-xl);
    margin-inline: auto;
  }
  /* the App Store slot — once live, the page's "stamp" (its one allowed glow,
     a screen below the hero player). */
  .final__cta {
    margin-top: var(--space-3xl);
  }
  /* pre-launch placeholder: a quiet, deliberate "coming soon" enamel pill —
     NOT amber-filled (it isn't actionable yet), so no glow competes. */
  .final__soon {
    margin-top: var(--space-3xl);
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: 3.5rem;
    padding: 0 1.4rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-body-lg);
    letter-spacing: 0.01em;
    color: var(--ink-dim);
    background: var(--surface-raised);
    border: var(--border-keyline) solid var(--keyline);
    border-radius: var(--radius-pill);
  }
  .final__soon :global(svg) {
    color: var(--accent-warm);
  }
  .final__micro {
    margin-top: var(--space-xl);
    font-size: var(--fs-meta);
    color: var(--ink-faint);
    max-width: 34rem;
  }
  .final__secondary {
    margin-top: var(--space-md);
  }
  .final__trailwrap {
    margin-top: var(--space-4xl);
    width: 100%;
    max-width: 40rem;
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }
  .final__trail {
    flex: 1 1 auto;
  }
  .final__wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-subhead);
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    flex: none;
  }
</style>
