---
// A small vector line-icon set, semantic names (mirrors the app's Icon.tsx idea:
// icons are VECTOR, never emoji). Stroke uses currentColor so callers set color
// via a parent's `color`. Size via the `size` prop (px).
interface Props {
  name: string
  size?: number
  /** extra class for color/utility */
  class?: string
  'aria-hidden'?: boolean
}
const { name, size = 24, class: klass = '', ...rest } = Astro.props

// Inner markup per icon, drawn on a 24×24 grid, 1.6 stroke, round joins.
const ICONS: Record<string, string> = {
  play: '<path d="M8 5.5v13l11-6.5L8 5.5Z" fill="currentColor" stroke="none"/>',
  pause: '<rect x="7" y="5.5" width="3.4" height="13" rx="1" fill="currentColor" stroke="none"/><rect x="13.6" y="5.5" width="3.4" height="13" rx="1" fill="currentColor" stroke="none"/>',
  download:
    '<path d="M12 3.5v11m0 0 4-4m-4 4-4-4"/><path d="M4.5 16.5v2.5a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1v-2.5"/>',
  cloud:
    '<path d="M7.2 18.5A4.2 4.2 0 0 1 7 10.1a5 5 0 0 1 9.6-1.4 3.7 3.7 0 0 1 .4 7.4"/><path d="M12 11v6m0 0 2.3-2.3M12 17l-2.3-2.3"/>',
  car: '<path d="M3.5 16.5v-2.2l1.8-4.3A2 2 0 0 1 7.1 8.7h9.8a2 2 0 0 1 1.8 1.3l1.8 4.3v2.2"/><path d="M3.5 14.3h17"/><circle cx="7.5" cy="16.8" r="1.8"/><circle cx="16.5" cy="16.8" r="1.8"/>',
  mount:
    '<rect x="7" y="3.5" width="10" height="17" rx="2.2"/><path d="M10 6.5h4"/><circle cx="12" cy="17" r="1.1" fill="currentColor" stroke="none"/>',
  offline:
    '<path d="M3 4 21 20"/><path d="M5 10.5a11 11 0 0 1 3.2-2M12 6.5c2.9 0 5.6 1 7.6 2.8M8.5 14a6 6 0 0 1 2-1.3M15.4 12.6a6 6 0 0 1 1.2.8"/><path d="M12 17.7h.01"/>',
  duck: '<path d="M4 9.5v5h3l4 3.5V6L7 9.5H4Z"/><path d="M15 9.2a4 4 0 0 1 0 5.6"/>',
  routeLoop:
    '<circle cx="6.5" cy="6.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/><path d="M8.5 6.5h5a4 4 0 0 1 0 8H10a4 4 0 0 0 0-8" stroke-dasharray="2 2.2"/>',
  routeOpen:
    '<circle cx="5" cy="18.5" r="1.8"/><path d="M6.6 17.4C9 14 7.5 11 10.5 9.2s4.2 1 6-1.2" stroke-dasharray="2 2.4"/><path d="M16 5.5l2.5 1-1 2.6"/>',
  mappin:
    '<path d="M12 21s6-5.3 6-10a6 6 0 1 0-12 0c0 4.7 6 10 6 10Z"/><circle cx="12" cy="11" r="2.2"/>',
  book: '<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v15H5.5A1.5 1.5 0 0 0 4 20.5V5.5Z"/><path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H13v15h5.5A1.5 1.5 0 0 1 20 20.5V5.5Z"/>',
  signpost:
    '<path d="M12 3.5v17"/><path d="M5 6.5h10l2.5 2-2.5 2H5V6.5Z"/><path d="M19 12.5H9l-2.5 2 2.5 2h10v-4Z"/>',
  sparkle:
    '<path d="M12 3.5l1.7 4.8L18.5 10l-4.8 1.7L12 16.5l-1.7-4.8L5.5 10l4.8-1.7L12 3.5Z"/><path d="M18.5 15.5l.7 1.9 1.9.7-1.9.7-.7 1.9-.7-1.9-1.9-.7 1.9-.7.7-1.9Z"/>',
  quote:
    '<path d="M9.5 7C7 8 5.5 10 5.5 13v4h5v-5H8c0-1.7.8-3 2.4-3.6L9.5 7ZM19 7c-2.5 1-4 3-4 6v4h5v-5h-2.5c0-1.7.8-3 2.4-3.6L19 7Z" fill="currentColor" stroke="none"/>',
  headphones:
    '<path d="M4.5 14v-1.5a7.5 7.5 0 0 1 15 0V14"/><rect x="3.5" y="13.5" width="3.5" height="6" rx="1.4"/><rect x="17" y="13.5" width="3.5" height="6" rx="1.4"/>',
  arrowRight: '<path d="M4.5 12h14m0 0-5-5m5 5-5 5"/>',
  envelope:
    '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="M4.5 7.5 12 13l7.5-5.5"/>',
  stamp:
    '<rect x="4.5" y="4.5" width="15" height="15" rx="2" stroke-dasharray="2.4 2"/><circle cx="12" cy="12" r="3.4"/>',
  coffee:
    '<path d="M5 8.5h11v4a4.5 4.5 0 0 1-9 0v-4Z"/><path d="M16 9.5h1.8a2 2 0 0 1 0 4H16"/><path d="M6.5 5l.6-1.4M9.5 5l.6-1.4M12.5 5l.6-1.4"/>',
}

const inner = ICONS[name] ?? ICONS.signpost
const hidden = rest['aria-hidden'] ?? true
---

<svg
  class={klass}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={hidden ? 'true' : undefined}
  set:html={inner}
/>
