---
// The enamel travel-badge medallion — the Skipper's "portrait" stand-in (honest:
// no faked headshot). A national-park patch: arced "THE SKIPPER" up top, a dusk
// ridgeline with the sun and the car token cresting a dashed trail, a straight
// "LAKE TAHOE" banner. Amber is rim-light + token only; type stays parchment.
import { CAR_BODY_PATH } from './carBody'

interface Props {
  size?: number
  class?: string
}
const { size = 200, class: klass = '' } = Astro.props
---

<svg
  class={`medallion ${klass}`}
  width={size}
  height={size}
  viewBox="0 0 200 200"
  role="img"
  aria-label="The Skipper: Lake Tahoe enamel travel badge"
>
  <defs>
    <clipPath id="med-field"><circle cx="100" cy="100" r="78"></circle></clipPath>
    <path id="med-arc-top" d="M30 100 a70 70 0 1 1 140 0" fill="none"></path>
  </defs>

  <!-- rings -->
  <circle cx="100" cy="100" r="95" fill="var(--surface-raised)" stroke="var(--amber)" stroke-width="2"></circle>
  <circle cx="100" cy="100" r="86" fill="none" stroke="var(--keyline)" stroke-width="1.5"></circle>
  <circle cx="100" cy="100" r="80" fill="none" stroke="var(--track-inactive)" stroke-width="1.4" stroke-dasharray="2.5 3.5"></circle>
  <circle cx="100" cy="100" r="78" fill="var(--surface-sunken)"></circle>

  <!-- inner scene -->
  <g clip-path="url(#med-field)">
    <!-- sky stars -->
    <circle cx="58" cy="64" r="1.5" fill="var(--amber)" opacity="0.85"></circle>
    <circle cx="142" cy="58" r="1.7" fill="var(--amber)" opacity="0.85"></circle>
    <circle cx="120" cy="44" r="1.2" fill="var(--ink-dim)" opacity="0.7"></circle>
    <!-- sun -->
    <circle cx="100" cy="92" r="15" fill="var(--amber)" opacity="0.95"></circle>
    <circle cx="100" cy="92" r="15" fill="none" stroke="var(--surface-sunken)" stroke-width="1"></circle>
    <!-- back ridge -->
    <path d="M22 150 L60 116 L92 142 L118 112 L150 140 L178 150 Z" fill="var(--accent)" opacity="0.4"></path>
    <!-- front ridge -->
    <path d="M22 162 L52 132 L84 158 L110 128 L140 156 L178 162 L178 178 L22 178 Z" fill="var(--accent)"></path>
    <!-- dashed cresting trail -->
    <path d="M30 150 C58 150 64 120 92 120 C120 120 126 150 170 150" fill="none" stroke="var(--track-inactive)" stroke-width="1.6" stroke-dasharray="3 3"></path>
    <!-- car token on the crest -->
    <g transform="translate(80 110) scale(0.9)" style="color:var(--amber)">
      <path d={CAR_BODY_PATH} fill="currentColor"></path>
      <circle cx="10.5" cy="14.4" r="3" fill="var(--surface-sunken)"></circle>
      <circle cx="25" cy="14.4" r="3" fill="var(--surface-sunken)"></circle>
    </g>
    <!-- banner — kept high enough (and narrow enough) that the round field clip
         (r=78) doesn't slice the ribbon ends or the "LAKE TAHOE" text -->
    <g>
      <path d="M56 146 H144 L138 156 L144 166 H56 L62 156 Z" fill="var(--surface-raised)" stroke="var(--keyline)" stroke-width="1"></path>
      <text x="100" y="159.5" text-anchor="middle" fill="var(--ink)"
        font-family="'Overpass Mono', monospace" font-size="9" font-weight="600" letter-spacing="1.2">LAKE TAHOE</text>
    </g>
  </g>

  <!-- arced top text -->
  <text fill="var(--ink)" font-family="'Zilla Slab', serif" font-size="16" font-weight="700" letter-spacing="2">
    <textPath href="#med-arc-top" startOffset="50%" text-anchor="middle">THE SKIPPER</textPath>
  </text>
</svg>

<style>
  .medallion {
    filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.45));
  }
</style>
