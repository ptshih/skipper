---
// Custom 404 — Firebase Hosting serves dist/404.html for any unmatched path,
// and Astro builds this page to exactly that. Matches the landing page styling.
const title = 'Off the route — Skipper'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <style>
      :root {
        color-scheme: dark;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        background: #14201b;
        color: #f2e7cc;
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        text-align: center;
        padding: 2rem;
      }
      .code {
        font-size: clamp(3rem, 10vw, 5rem);
        margin: 0;
        letter-spacing: -0.02em;
      }
      p {
        margin: 0.5rem 0 1.5rem;
        opacity: 0.7;
        font-size: 1.125rem;
      }
      a {
        color: #f2e7cc;
        text-decoration: underline;
        text-underline-offset: 4px;
        opacity: 0.85;
      }
    </style>
  </head>
  <body>
    <main>
      <p class="code">404</p>
      <p>Looks like we've drifted off the route.</p>
      <a href="/">Back to the dock →</a>
    </main>
  </body>
</html>
