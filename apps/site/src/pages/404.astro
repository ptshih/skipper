---
// Custom 404 — Firebase Hosting serves dist/404.html for any unmatched path,
// and Astro builds this page to exactly that. Uses the Base shell + Trailhead-89
// tokens so it matches the landing page (noindex).
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
---

<Base
  title="Off the route — Skipper"
  description="Looks like we’ve drifted off the route. Head back to the trailhead — Skipper is a narrated driving tour for Lake Tahoe, coming soon to iOS."
  noindex={true}
>
  <main id="main" class="lost">
    <!-- The page shipped with NO heading at all, so pressing H / opening the rotor on a mistyped
         skipper.fm URL returned nothing and a screen-reader user had to read linearly to find out
         they were on an error page. The numeral carries the meaning visually; the h1 carries it
         for AT, which is why the visible "404" is hidden from the tree rather than read twice. -->
    <p class="lost__code" aria-hidden="true">404</p>
    <h1 class="lost__line">404 — looks like we’ve drifted off the route, folks.</h1>
    <a class="btn btn--secondary" href="/">
      <Icon name="arrowRight" size={18} /> Back to the trailhead
    </a>
  </main>
</Base>

<style>
  .lost {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: var(--space-lg);
    padding: var(--gutter);
  }
  .lost__code {
    font-family: var(--font-display);
    font-weight: 700;
    /* the one deliberate off-scale size — a standalone error page's giant numeral */
    font-size: clamp(4rem, 16vw, 7rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .lost__line {
    color: var(--ink-dim);
    font-size: var(--fs-subhead);
    margin-bottom: var(--space-sm);
  }
</style>
