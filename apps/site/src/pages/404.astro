---
// Custom 404 — Firebase Hosting serves dist/404.html for any unmatched path,
// and Astro builds this page to exactly that. Uses the Base shell + Trailhead-89
// tokens so it matches the landing page (noindex).
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
---

<Base
  title="Off the route — Skipper"
  description="Looks like we’ve drifted off the route. Head back to the trailhead — Skipper is an AI-narrated driving tour for Lake Tahoe, coming soon to iOS."
  noindex={true}
>
  <main class="lost">
    <p class="lost__code">404</p>
    <p class="lost__line">Looks like we’ve drifted off the route, folks.</p>
    <a class="btn btn--secondary" href="/">
      <Icon name="arrowRight" size={18} /> Back to the trailhead
    </a>
  </main>
</Base>

<style>
  .lost {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: var(--space-lg);
    padding: var(--gutter);
  }
  .lost__code {
    font-family: var(--font-display);
    font-weight: 700;
    /* the one deliberate off-scale size — a standalone error page's giant numeral */
    font-size: clamp(4rem, 16vw, 7rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .lost__line {
    color: var(--ink-dim);
    font-size: var(--fs-subhead);
    margin-bottom: var(--space-sm);
  }
</style>
