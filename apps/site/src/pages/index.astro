---
// skipper.fm — the apex landing page. A charm-first brand front-door for a
// PRE-LAUNCH app (App Store coming soon): the only action is hearing the
// Skipper; the App Store link drops into the closing slot at launch. Section architecture + copy
// synthesized from a research pass on autio.com / shakaguide.com against our own
// positioning (regional depth over catalog scale; the anti-"reads a fixed
// script"; honest, no fake metrics). Dusk-mode "Trailhead 89" throughout.
import Base from '../layouts/Base.astro'
import Nav from '../components/sections/Nav.astro'
import Hero from '../components/sections/Hero.astro'
import HowItWorks from '../components/sections/HowItWorks.astro'
import Modes from '../components/sections/Modes.astro'
import WhySkipper from '../components/sections/WhySkipper.astro'
import TheDrive from '../components/sections/TheDrive.astro'
import Objections from '../components/sections/Objections.astro'
import FounderNote from '../components/sections/FounderNote.astro'
import FinalCta from '../components/sections/FinalCta.astro'
import SiteFooter from '../components/sections/SiteFooter.astro'
import StickyCta from '../components/sections/StickyCta.astro'
---

<Base>
  <Nav />
  <main>
    <Hero />
    <HowItWorks />
    <Modes />
    <WhySkipper />
    <TheDrive />
    <Objections />
    <FounderNote />
    <FinalCta />
  </main>
  <SiteFooter />
  <StickyCta />
</Base>

<script>
  // One voice at a time. The hero clip, the itinerary sampler, and the sticky
  // bar each own their own <audio>; this capture-phase guard pauses every OTHER
  // audio element the moment one starts, so two Skippers never talk at once.
  document.addEventListener(
    'play',
    (e) => {
      const t = e.target
      if (!(t instanceof HTMLAudioElement)) return
      document.querySelectorAll('audio').forEach((a) => {
        if (a !== t) a.pause()
      })
    },
    true
  )
</script>
