---
// /reset-password — the ONE auth surface that can't live in the app.
//
// Why it's on the web at all: a rider who's forgotten their password opens the reset link from a
// mail client, and a mail link can't be relied on to hand off into a specific native app. Worse, a
// reset that only works on the device still holding a session isn't a reset. So the app asks for the
// link (apps/mobile/app/sign-in.tsx → requestPasswordReset with redirectTo: this page) and the
// journey finishes here, on any browser.
//
// The flow, end to end:
//   1. app  → POST /api/auth/request-password-reset { email, redirectTo: <this page> }
//   2. mail → GET  /api/auth/reset-password/:token?callbackURL=<this page>
//   3. that redirects HERE with ?token=… (or ?error=… if the token was already spent/expired)
//   4. this page → POST /api/auth/reset-password { newPassword, token }
//
// Static page + a client script: there's no server here (Astro static → Firebase Hosting), and none
// is needed — the API does every check. The token is single-use and expires in an hour.
//
// noindex: a utility page with a one-time token in the URL has no business in a search index.
import Base from '../layouts/Base.astro'
import SiteFooter from '../components/sections/SiteFooter.astro'

// The API host. Separate service from this site (Cloud Run vs Firebase Hosting) — see
// apps/api/src/auth.ts. Overridable so a local site build can point at a local API.
const API_URL = import.meta.env.PUBLIC_API_URL ?? 'https://api.skipper.fm'
---

<Base
  title="Reset your password — Skipper"
  description="Set a new password for your Skipper account."
  noindex={true}
>
  <main id="main" class="section">
    <div class="container">
      <div class="prose reset">
        <span class="kicker">Account</span>
        <h1 class="title">Set a new password</h1>

        {/* Every state is rendered up-front and toggled by the script — no layout shift, and the
            page is useful even if the script is slow. `form` is the default; the script swaps. */}
        <div class="framed reset__panel">
          <form id="reset-form" class="reset__form" hidden>
            <label class="reset__label" for="password">New password</label>
            <input
              id="password"
              name="password"
              class="reset__input"
              type="password"
              autocomplete="new-password"
              minlength="8"
              aria-describedby="reset-error"
              required
            />

            <label class="reset__label" for="confirm">Type it again</label>
            <input
              id="confirm"
              name="confirm"
              class="reset__input"
              type="password"
              autocomplete="new-password"
              minlength="8"
              aria-describedby="reset-error"
              required
            />

            <p id="reset-error" class="reset__error" role="alert" hidden></p>

            <button id="reset-submit" class="btn btn--primary reset__submit" type="submit">
              Save the new password
            </button>
          </form>

          {/* No token in the URL, or the API rejected it (spent, expired, tampered). */}
          <div id="reset-invalid" role="status" tabindex="-1" hidden>
            <p class="body-dim">
              This link has run out of road — it works once, and only for an hour after it's sent.
            </p>
            <p class="body-dim">Open the Skipper app and ask for a fresh one.</p>
          </div>

          <div id="reset-done" role="status" tabindex="-1" hidden>
            <p class="body-dim">
              Done — that's your new password. Head back to the Skipper app and sign in.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />
</Base>

<script is:inline define:vars={{ API_URL }}>
  // Plain inline script: one form, one fetch, no framework. `define:vars` passes the build-time API
  // host in (an inline script can't read import.meta.env at runtime).
  const params = new URLSearchParams(window.location.search)
  const token = params.get('token')

  const form = document.getElementById('reset-form')
  const invalid = document.getElementById('reset-invalid')
  const done = document.getElementById('reset-done')
  const errorEl = document.getElementById('reset-error')
  const submit = document.getElementById('reset-submit')
  const pw = /** @type {HTMLInputElement} */ (document.getElementById('password'))
  const cf = /** @type {HTMLInputElement} */ (document.getElementById('confirm'))

  const show = (el) => el && (el.hidden = false)
  const hide = (el) => el && (el.hidden = true)

  // Reveal a terminal panel AND put focus in it. Both outcomes replace the form, which destroys the
  // focused submit button — focus fell back to <body>, so a screen-reader user heard nothing, and
  // Tab restarted from the top of the document. On this page in particular, "did my password
  // actually change?" is the difference between getting back in and being locked out.
  const finish = (el) => {
    hide(form)
    show(el)
    el?.focus()
  }

  const fail = (message, field) => {
    if (!errorEl) return
    errorEl.textContent = message
    errorEl.hidden = false
    // Mark the offending field and send focus there. role="alert" on an element that is un-hidden
    // after its text is set is unreliable (VoiceOver frequently misses it), and the message was not
    // attached to either input, so tabbing back announced a plain "secure edit text".
    // No field means the failure wasn't the rider's input (a dead API, a 500) — nothing is invalid.
    if (field) {
      for (const el of [pw, cf]) el?.setAttribute('aria-invalid', String(el === field))
      field.focus()
    }
  }

  // Better Auth redirects here with ?error=… when the token was already spent or expired — there's
  // nothing to submit in that case, so never render the form.
  if (!token || params.get('error')) {
    show(invalid)
  } else {
    show(form)
    form?.addEventListener('submit', async (e) => {
      e.preventDefault()
      hide(errorEl)
      for (const el of [pw, cf]) el?.setAttribute('aria-invalid', 'false')
      const password = pw.value
      const confirm = cf.value

      // Check the cheap things here so a typo costs a round-trip instead of the token: the API
      // consumes a valid token on a successful reset, and there's only one.
      if (password.length < 8) return fail('Passwords need at least 8 characters.', pw)
      if (password !== confirm) return fail("Those two don't match. Try again?", cf)

      submit.disabled = true
      submit.textContent = 'Saving…'
      try {
        const res = await fetch(`${API_URL}/api/auth/reset-password`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ newPassword: password, token }),
        })
        if (res.ok) {
          finish(done)
          return
        }
        // A dead token is terminal — swap to the "ask for a fresh one" state rather than leave a
        // form that can never succeed. Anything else is worth another try.
        const body = await res.json().catch(() => ({}))
        if (res.status === 400 || res.status === 403) {
          finish(invalid)
          return
        }
        fail(body?.message ?? 'That didn’t take. Give it another pull?')
      } catch {
        fail('Couldn’t reach the Skipper. Check your connection and try again.')
      } finally {
        submit.disabled = false
        submit.textContent = 'Save the new password'
      }
    })
  }
</script>

<style>
  .reset {
    max-width: var(--maxw-prose);
  }
  .reset__panel {
    margin-top: var(--space-xl);
    padding: var(--space-xl);
  }
  .reset__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .reset__label {
    font-family: var(--font-mono);
    font-size: var(--fs-label-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: var(--space-md);
  }
  .reset__input {
    width: 100%;
    padding: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--ink);
    background: var(--surface-sunken);
    border: var(--border-thin) solid var(--rule);
    border-radius: var(--radius-sm);
  }
  .reset__input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .reset__error {
    color: var(--danger);
    font-size: var(--fs-sm);
    margin-top: var(--space-xs);
  }
  .reset__submit {
    margin-top: var(--space-lg);
  }
</style>
