---
// The shared document shell for skipper.fm — <head> (meta + Open Graph + fonts)
// and the global stylesheet. Pages drop their sections into the <slot/>.
//
// Fonts: the Trailhead-89 trio (Zilla Slab display, Lora body, Overpass Mono
// numerals) — the same families the app loads via @expo-google-fonts. Served
// from Google Fonts here (lowest-friction for a static Firebase host); preconnect
// + display=swap keep the first paint fast. If a fully self-hosted/offline build
// is ever wanted, swap to @fontsource — see docs note in the repo.
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  /** Override the OG/Twitter image (absolute path under the site). */
  image?: string
  /** Alt text for the social card image. */
  imageAlt?: string
  /** Set true on noindex pages (e.g. 404). */
  noindex?: boolean
}

const {
  title = 'Skipper — AI-narrated driving tours',
  description = 'A corny old tour guide rides shotgun and narrates your drive — GPS-triggered audio tours for your phone, with a Jungle-Cruise heart. Coming soon to iOS, starting with Lake Tahoe.',
  image = '/og.png',
  imageAlt = 'Skipper — an AI-narrated Lake Tahoe driving tour; a corny old guide rides shotgun.',
  noindex = false,
} = Astro.props

// Minimal, honest brand structured data (no fake ratings). Skipped on noindex pages.
const ldJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Skipper',
      url: Astro.site?.href,
      logo: new URL('/favicon.svg', Astro.site).href,
      description,
    },
    { '@type': 'WebSite', name: 'Skipper', url: Astro.site?.href },
  ],
})

// Absolute URLs for canonical + social cards (Astro.site = https://skipper.fm).
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(image, Astro.site)
const fontHref =
  'https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@700&family=Lora:ital,wght@0,400;0,600;0,700&family=Overpass+Mono:wght@400;600&display=swap'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14201B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skipper" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {!noindex && <script type="application/ld+json" set:html={ldJson} />}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontHref} />
    <link rel="stylesheet" href={fontHref} />
  </head>
  <body>
    <slot />
  </body>
</html>
