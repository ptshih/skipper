---
// The shared document shell for skipper.fm — <head> (meta + Open Graph + fonts)
// and the global stylesheet. Pages drop their sections into the <slot/>.
//
// Fonts: the Trailhead-89 trio (Zilla Slab display, Lora body, Overpass Mono
// numerals) — the same families the app loads via @expo-google-fonts.
//
// SELF-HOSTED via @fontsource (2026-07-30), previously a Google Fonts <link>. The stylesheet link was
// the ONLY cross-origin blocking resource on the page, and `preload as=style` in front of it does not
// make it non-blocking — the browser still waits on that response before first paint, and
// `display=swap` only governs the font FILE swap, not the CSS fetch. Self-hosting removes a whole
// cross-origin round trip from FCP and stops leaking every visitor's IP to a third party on page load,
// which also keeps the privacy page honest about who receives data.
//
// Imported per WEIGHT and per SUBSET on purpose — Fontsource's bare package import pulls all seven
// subsets (cyrillic, math, symbols, vietnamese…). The site is English and US-only, so latin +
// latin-ext is everything it renders; anything outside those ranges falls back to the stack in
// tokens.css exactly as it does today. Add a subset here if that ever stops being true.
//
// ⚠ NO italic face, deliberately. The Google request never asked for one either
// (`Lora:ital,wght@0,400;0,600;0,700` is ital=0 throughout), so the `<em>` in the legal pages has
// always rendered as a browser-synthesised oblique. Adding a real italic would be a typography
// change, not a hosting change — worth doing, but not smuggled in here.
import '@fontsource/zilla-slab/latin-700.css'
import '@fontsource/zilla-slab/latin-ext-700.css'
import '@fontsource/lora/latin-400.css'
import '@fontsource/lora/latin-ext-400.css'
import '@fontsource/lora/latin-600.css'
import '@fontsource/lora/latin-ext-600.css'
import '@fontsource/lora/latin-700.css'
import '@fontsource/lora/latin-ext-700.css'
import '@fontsource/overpass-mono/latin-400.css'
import '@fontsource/overpass-mono/latin-ext-400.css'
import '@fontsource/overpass-mono/latin-600.css'
import '@fontsource/overpass-mono/latin-ext-600.css'
import '../styles/global.css'
import { APP_STORE_URL } from '../appStore'

interface Props {
  title?: string
  description?: string
  /** Override the OG/Twitter image (absolute path under the site). */
  image?: string
  /** Alt text for the social card image. */
  imageAlt?: string
  /** Set true on noindex pages (e.g. 404). */
  noindex?: boolean
}

const {
  title = 'Skipper — narrated audio driving tours for Lake Tahoe',
  description = 'A corny old tour guide rides shotgun and narrates your drive — GPS-triggered audio tours for your phone, with a Jungle-Cruise heart. Coming soon to iOS, starting with Lake Tahoe.',
  image = '/og.png',
  imageAlt = 'Skipper — a narrated Lake Tahoe driving tour; a corny old guide rides shotgun.',
  noindex = false,
} = Astro.props

// Minimal, honest brand structured data. Skipped on noindex pages.
//
// The `MobileApplication` node exists to answer a disambiguation problem, not to chase a
// vendor-promised ranking lift: "Skipper" collides with a pile of boating apps, and this is the
// cheapest way to assert which entity this domain is about. Google reads it for ordinary rich
// results; whether any LLM reads it is undocumented either way, so the justification is simply that
// it's CORRECT metadata about a real product. See docs/ideas/llm-discovery-marketing.md §5.2.
//
// ⚠ NEVER add `aggregateRating` or `review` here. There are zero users, so any value would be
// fabricated — a Google spam-policy violation that would also torch the one asset (honesty) the
// whole product positioning rests on.
//
// ⚠ `TouristTrip`/`TouristAttraction` are tempting and deliberately NOT used: they describe a
// specific itinerary or place, and asserting one on a page that renders neither would be a lie in
// schema form.
const storeLinks = APP_STORE_URL ? { sameAs: [APP_STORE_URL], installUrl: APP_STORE_URL } : {}
const ldJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Skipper',
      url: Astro.site?.href,
      logo: new URL('/favicon.svg', Astro.site).href,
      description,
      ...(APP_STORE_URL ? { sameAs: [APP_STORE_URL] } : {}),
    },
    { '@type': 'WebSite', name: 'Skipper', url: Astro.site?.href },
    {
      '@type': 'MobileApplication',
      name: 'Skipper',
      applicationCategory: 'TravelApplication',
      operatingSystem: 'iOS',
      // The official page while the listing is unreleased; the store URL joins as `installUrl` +
      // `sameAs` the moment APP_STORE_URL is set (§13). Pointing `url` at a 404 would be worse
      // than pointing it here.
      url: Astro.site?.href,
      description,
      // True and load-bearing: the app is free. Premium is CREDITS, bought in-app later, never a
      // paid download — see docs/decisions/cut-tiers.md.
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      ...storeLinks,
    },
  ],
})

// Absolute URLs for canonical + social cards (Astro.site = https://skipper.fm).
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(image, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#14201B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skipper" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {!noindex && <script type="application/ld+json" set:html={ldJson} />}

    <!-- Fonts are self-hosted (see the @fontsource imports above) — no preconnect, no third-party
         stylesheet, nothing cross-origin left to block first paint. -->
  </head>
  <body>
    <slot />
  </body>
</html>
