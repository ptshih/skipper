---
// The shared document shell for skipper.fm — <head> (meta + Open Graph + fonts)
// and the global stylesheet. Pages drop their sections into the <slot/>.
//
// Fonts: the Trailhead-89 trio (Zilla Slab display, Lora body, Overpass Mono
// numerals) — the same families the app loads via @expo-google-fonts.
//
// SELF-HOSTED via @fontsource (2026-07-30), previously a Google Fonts <link>. The stylesheet link was
// the ONLY cross-origin blocking resource on the page, and `preload as=style` in front of it does not
// make it non-blocking — the browser still waits on that response before first paint, and
// `display=swap` only governs the font FILE swap, not the CSS fetch. Self-hosting removes a whole
// cross-origin round trip from FCP and stops leaking every visitor's IP to a third party on page load,
// which also keeps the privacy page honest about who receives data.
//
// Imported per WEIGHT and per SUBSET on purpose — Fontsource's bare package import pulls all seven
// subsets (cyrillic, math, symbols, vietnamese…). Anything outside the imported range falls back to
// the stack in tokens.css. Add a subset here if that ever stops being true.
//
// ⚠⚠ LATIN ONLY — DO NOT ADD THE latin-ext IMPORTS BACK. They shipped alongside latin until
// 2026-08-02 and were actively harmful, because Fontsource's PER-SUBSET files carry no
// `unicode-range` (only the aggregate `400.css`-style files do — verified: latin-400.css has 0,
// 400.css has 7). Without it the browser cannot subset: 12 @font-face rules with identical
// family/style/weight and no range, and latin-ext declared LAST, so per CSS Fonts §5.2 latin-ext
// won for ALL text. Every visitor fetched a latin-ext file (94,796 bytes across the six), found no
// glyph for `a` or `—`, and only then fell through to latin — a second serial round trip in front
// of every word, lengthening the font-display:swap flash.
// It buys nothing here: latin covers U+2000-206F, which is where this site's only non-ASCII
// characters live (— U+2014, ' U+2019). latin-ext is U+0100-02BA etc — Central/Eastern European
// accents the copy never renders. If real latin-ext coverage is ever wanted, import the AGGREGATE
// weight files (@fontsource/lora/400.css), which ship the ranges that make subsetting work.
//
// ⚠ NO italic face, deliberately. The Google request never asked for one either
// (`Lora:ital,wght@0,400;0,600;0,700` is ital=0 throughout), so the `<em>` in the legal pages has
// always rendered as a browser-synthesised oblique. Adding a real italic would be a typography
// change, not a hosting change — worth doing, but not smuggled in here.
import '@fontsource/zilla-slab/latin-700.css'
import '@fontsource/lora/latin-400.css'
import '@fontsource/lora/latin-600.css'
import '@fontsource/lora/latin-700.css'
import '@fontsource/overpass-mono/latin-400.css'
import '@fontsource/overpass-mono/latin-600.css'
import '../styles/global.css'
import { APP_STORE_URL } from '../appStore'
//
// The skip link below is WCAG 2.4.1 Bypass Blocks. Every page puts a header before <main> — the
// landing nav's five links, the legal pages' back-link — and a keyboard-only user had no way past it.
// ⚠ Every <main> on the site carries id="main"; a new page needs one too or the link goes nowhere.

interface Props {
  title?: string
  description?: string
  /** Override the OG/Twitter image (absolute path under the site). */
  image?: string
  /** Alt text for the social card image. */
  imageAlt?: string
  /** Set true on noindex pages (e.g. 404). */
  noindex?: boolean
}

const {
  title = 'Skipper: narrated audio driving tours for Lake Tahoe',
  // The launch-status clause flips with APP_STORE_URL — part of the one-constant go-live (§13),
  // like every other "coming soon" line on the site. Indexed copy, so it must not lag the release.
  description = APP_STORE_URL
    ? 'A corny old tour guide rides shotgun and narrates your drive: GPS-triggered audio tours for your phone, with a Jungle-Cruise heart. Free on the App Store, starting with Lake Tahoe.'
    : 'A corny old tour guide rides shotgun and narrates your drive: GPS-triggered audio tours for your phone, with a Jungle-Cruise heart. Coming soon to iOS, starting with Lake Tahoe.',
  image = '/og.png',
  imageAlt = 'Skipper: a narrated Lake Tahoe driving tour; a corny old guide rides shotgun.',
  noindex = false,
} = Astro.props

// Minimal, honest brand structured data. Skipped on noindex pages.
//
// The `MobileApplication` node exists to answer a disambiguation problem, not to chase a
// vendor-promised ranking lift: "Skipper" collides with a pile of boating apps, and this is the
// cheapest way to assert which entity this domain is about. Google reads it for ordinary rich
// results; whether any LLM reads it is undocumented either way, so the justification is simply that
// it's CORRECT metadata about a real product. See docs/designs/llm-discovery-marketing.md §5.2.
//
// ⚠ NEVER add `aggregateRating` or `review` here. There are zero users, so any value would be
// fabricated — a Google spam-policy violation that would also torch the one asset (honesty) the
// whole product positioning rests on.
//
// ⚠ `TouristTrip`/`TouristAttraction` are tempting and deliberately NOT used: they describe a
// specific itinerary or place, and asserting one on a page that renders neither would be a lie in
// schema form.
// ⚠ The ENTITY description is not the PAGE description. This markup renders on every indexable
// page, so binding the Organization/MobileApplication `description` to the per-page prop emitted
// five contradictory copies of the same unkeyed entity — /terms told a crawler, as machine-readable
// fact, that the Organization "Skipper" IS "the terms for using Skipper: drive safely, the narration
// is AI-generated…", and /support that it is "Help with Skipper — coverage, location, audio…".
// One brand sentence here; the per-page `description` stays with <meta>/og/twitter where it belongs.
const BRAND_DESCRIPTION =
  'Skipper is a narrated audio driving tour for iPhone: a corny old guide rides shotgun and tells you ' +
  'the story of each place as you reach it, GPS-triggered and grounded in cited public sources. ' +
  'Starting with Lake Tahoe.'

// @id so the repeated nodes across pages reconcile to ONE entity instead of competing.
const ORG_ID = new URL('#org', Astro.site).href
const SITE_ID = new URL('#website', Astro.site).href
const APP_ID = new URL('#app', Astro.site).href

const storeLinks = APP_STORE_URL ? { sameAs: [APP_STORE_URL], installUrl: APP_STORE_URL } : {}
const ldJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: 'Skipper',
      url: Astro.site?.href,
      description: BRAND_DESCRIPTION,
      ...(APP_STORE_URL ? { sameAs: [APP_STORE_URL] } : {}),
    },
    { '@type': 'WebSite', '@id': SITE_ID, name: 'Skipper', url: Astro.site?.href, publisher: { '@id': ORG_ID } },
    {
      '@type': 'MobileApplication',
      '@id': APP_ID,
      name: 'Skipper',
      applicationCategory: 'TravelApplication',
      operatingSystem: 'iOS',
      publisher: { '@id': ORG_ID },
      // The official page while the listing is unreleased; the store URL joins as `installUrl` +
      // `sameAs` the moment APP_STORE_URL is set (§13). Pointing `url` at a 404 would be worse
      // than pointing it here.
      url: Astro.site?.href,
      description: BRAND_DESCRIPTION,
      // True and load-bearing: the app is free. Premium is CREDITS, bought in-app later, never a
      // paid download — see docs/decisions/cut-tiers.md.
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      ...storeLinks,
    },
  ],
})

// Absolute URLs for canonical + social cards (Astro.site = https://skipper.fm).
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(image, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#14201B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skipper" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {!noindex && <script type="application/ld+json" set:html={ldJson} />}

    <!-- Fonts are self-hosted (see the @fontsource imports above) — no preconnect, no third-party
         stylesheet, nothing cross-origin left to block first paint. -->
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
