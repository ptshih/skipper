{
  "name": "@skipper/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild:ios": "expo prebuild --clean -p ios",
    "sim:erase": "xcrun simctl erase all",
    "testflight": "eas build --platform ios --profile production --auto-submit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint:tokens": "bun scripts/check-tokens.ts",
    "check": "bun run lint:tokens && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.23",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/overpass-mono": "^0.4.2",
    "@expo-google-fonts/zilla-slab": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@skipper/engine": "workspace:*",
    "@skipper/shared": "workspace:*",
    "better-auth": "^1.6.23",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-location": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "posthog-react-native": "^4.57.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~57.0.0",
    "expo-dev-client": "~57.0.7",
    "typescript": "^6.0.3"
  }
}
