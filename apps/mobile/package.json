{
  "name": "@skipper/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild:ios": "expo prebuild --clean -p ios",
    "sim:erase": "xcrun simctl erase all",
    "testflight": "eas build --platform ios --profile production --auto-submit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint:tokens": "bun scripts/check-tokens.ts",
    "check": "bun run lint:tokens && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.14",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/overpass-mono": "^0.4.2",
    "@expo-google-fonts/zilla-slab": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@skipper/drive-core": "workspace:*",
    "@skipper/shared": "workspace:*",
    "better-auth": "^1.6.14",
    "expo": "~56.0.9",
    "expo-audio": "~56.0.11",
    "expo-constants": "~56.0.17",
    "expo-dev-client": "~56.0.19",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.13",
    "expo-location": "~56.0.16",
    "expo-network": "~56.0.5",
    "expo-router": "~56.2.9",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "^56.0.10",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~56.0.14",
    "typescript": "^6.0.3"
  }
}
