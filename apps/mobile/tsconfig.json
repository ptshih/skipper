{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "//": "*.test.ts run under `bun test` (which provides bun:test types); tsc skips them.",
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
