{
  "expo": {
    "name": "Skipper",
    "slug": "skipper",
    "scheme": "skipper",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "tours.skipper.app",
      "supportsTablet": true
    },
    "android": {
      "package": "tours.skipper.app"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
